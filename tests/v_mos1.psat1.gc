// nmos p gate
verilog
ground \0 ;
attach ../vams/mosfet.so
attach ../vams/diode.so

options noincmode nobypass

paramset cmosp mosfet;
  parameter real l = 9.u;
  parameter real w = 9.u;
  parameter real nrd = 1.;
  parameter real nrs = 1.;
  parameter real as = 81.p;
  parameter real ad = 81.p;
 .polarity = -1;
 .l = l;
 .w = w;
 .nrd = nrd;
 .nrs = nrs;
 .as = as;
 .ad = ad;

 .level=1;
 .vto= -0.844345;
 .kp= 41.5964u;
 .gamma= 0.863074;
 .phi= 0.6;
 .rd= 0.;
 .rs= 0.;
 .cbd= 0.;
 .cbs= 0.;
 .is= 0.;
 .pb= 0.7;
 .cgso= 218.971p;
 .cgdo= 218.971p;
 .cgbo= 0.;
 .rsh= 0.;
 .cj= 384.4u;
 .mj= 0.4884;
 .cjsw= 527.2p;
 .mjsw= 0.3002;
 .js= 0.;
 .tox= 41.8n;
 .nsub= 15.3142E+15;
 .nss= 1.E+12;
 .tpg=1;
 .xj= 400.n;
 .ld= 265.073n;
 .uo= 503.521;
 .kf= 0.;
 .af= 1.;
 .fc= 0.5;
endparamset

module dut(d g s b);
  cmosp #(.l(9.u),.w(9.u),.nrd(1.),.nrs(1.),.as(81p),.ad(81p)) m1  ( d g s b);
endmodule

dut d ( \2 , \2 , \0 , \4 );

spice
Vds   3  0  -5.
Rds   2  3  100.K
Vbs   4  0  0.
.print op v(nodes) iter(0)
.op trace i
.print op i(v*) ps(v*)
.op
.print op id(d.m1) is(d.m1) ig(d.m1) ib(d.m1) ibd(d.m1) ibs(d.m1)
.op
.print op vgs(d.m1) vds(d.m1) vbs(d.m1) vbd(d.m1) von(d.m1) vdsat(d.m1)
.op
.print op gm(d.m1) gds(d.m1) gmb(d.m1) gbd(d.m1) gbs(d.m1)
.op
.print op cbdm(d.m1) cbsm(d.m1) cgsm(d.m1) cgdm(d.m1) cgbm(d.m1)
.op
.print op cqgs(d.m1) cqgd(d.m1) cqgb(d.m1) cqbd(d.m1) cqbs(d.m1)
.op
.print op qgs(d.m1) qgd(d.m1) qgb(d.m1) qbd(d.m1) qbs(d.m1)
.op
.print op cgsovl(d.m1) cgdovl(d.m1) cgbovl(d.m1) cgate(d.m1) region(d.m1)
.op
.print op cgst(d.m1) cgdt(d.m1) cgbt(d.m1)
.op
.print op vdm(d.m1) vgm(d.m1) vbm(d.m1) vsm(d.m1)
.op
.print op vd(d.m1) vg(d.m1) vb(d.m1) vs(d.m1) vth(d.m1) vgst(d.m1)
.op
.status notime
.end
