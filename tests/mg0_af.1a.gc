
attach ./modelgen_0.so


verilog

`modelgen
module test_af_1a(p, n);
	electrical p, n;
	parameter real v = 1;

	analog function real fct;
		inout x;
		integer x;
		real xx;
		begin
			xx = x;
			fct = exp(xx);
		end
	endfunction

	analog begin : main
		integer xxint;
		xxint = v;
		V(p, n) <+ fct(xxint);
	end
endmodule

!make test_af_1a.so > /dev/null
attach ./test_af_1a.so

parameter v1=0
test_af_1a #(.v(v1)) dut(\1 ,\0 );

list

print dc v(nodes) iter(0)
dc v1 -5 10 2
end
