verilog
// Mutual inductance test circuit. Floating coils

attach ./modelgen_1.so
attach ../vams/vpulse.so

`modelgen
module test_cpl1(p1, n1, p2, n2);
	electrical p1, n1, p2, n2;
   electrical i, j;
	parameter real l1=1.;
	parameter real l2=1.;
	parameter real k=0.;

	analog begin : cpl
		real T;
		real a;
		T = sqrt(l2/l1);
		I(p1, i) <+ idt(V(p1, i)) / (l1*(1-k));
		a = idt(V(p2, j)) / (l2*(1-k));
		I(p2, j) <+ a;

		I(i, n1) <+ - T * a;

		I(i, n1) <+ idt(V(i, n1)) / (k * l1);

		V(j, n2) <+ V(i, n1) * T;

	end
endmodule
`endmodelgen

!make test_cpl1.so > /dev/null
load ./test_cpl1.so


parameter real k = .75
test_cpl1 #(.l1(.56) .l2(.79) .k(k)) dut(\2 , g , \3 , h );
resistor #(.r(22)) r1a(\1 , \2 );
resistor #(.r(75)) r1b(\3 , h );

// missing ac_stim. use spice pulse for now
// vpulse #(.mag(1), .val0(0), .val1(1), .td(.002), .rise(.002), .fall(.002), .width(.002)) v1(\1 , \0 );

spice
v1 1 g  pulse(0 1 .002 .002 .002 .002 .01) ac 1

.options nopage
.list
.width out=132
.print ac v(r1b)
.op
.ac dec 2 .1 1k
.print tran v(r1b)
.tran .001 .01 0 .0001
.list
.status notime
.end
