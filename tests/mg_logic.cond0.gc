attach ./modelgen_2.so
load vams/vpulse.so
load vams/vsine.so

verilog

`modelgen test_logic_cond0
module test(a, b);
	electrical a;
	logic b;
	input b;
	inout a;

	(*desc="cnt"*) integer cnt;
	(*desc="st"*) real st = 0;
	always @(posedge(b)) begin
		cnt = cnt + 1;
		if(V(a) > 0) cnt = cnt + 100;
	end
endmodule

list

!make test_logic_cond0.so > /dev/null
attach ./test_logic_cond0.so

test #() dut(\1 , clk );

ground gnd
vsine #(.ampl(-1) .freq(1e9)) vv(\1 , gnd);
vpulse #(.val0(0) .val1(5) .width(100p) .period(200p)) v1(aclk, gnd);
nand #(20) n1(clk, aclk);

.model logic logic delay=1p rise=10p fall=15p

list

print tran v(1) l(clk) cnt(dut)
tran 1n basic
status notime
end
