verilog
// nmos n gate, vds = 0
attach ../vams/mosfet.so
attach ../vams/diode.so

* options trtol 1

paramset cmosn mosfet;
  parameter real l = 9.u;
  parameter real w = 9.u;
  parameter real nrd = 1.;
  parameter real nrs = 1.;
  parameter real as = 81.p;
  parameter real ad = 81.p;
 .l = l;
 .w = w;
 .nrd = nrd;
 .nrs = nrs;
 .as = as;
 .ad = ad;

 .level=1;
 .vto= 0.844345;
 .kp= 41.5964u;
 .gamma= 0.863074;
 .phi= 0.6;
 .rd= 0.;
 .rs= 0.;
 .cbd= 0.;
 .cbs= 0.;
 .is= 0.;
 .pb= 0.7;
 .cgso= 218.971p;
 .cgdo= 218.971p
 .cgbo= 0.;
 .rsh= 0.;
 .cj= 384.4u;
 .mj= 0.4884;
 .cjsw= 527.2p;
 .mjsw= 0.3002;
 .js= 0.;
 .tox= 41.8n;
 .nsub= 15.3142E+15;
 .nss= 1.E+12;
 .tpg= 1;
 .ld= 265.073n;
 .uo= 503.521;
 .kf= 0.;
 .af= 1.;
 .fc= 0.5;
 .tnom= 27;
endparamset

module dut(d g s b);
  cmosn #(.l(9.u),.w(9.u),.nrd(1.),.nrs(1.)) m1  ( d g s b);
endmodule

// M1   2  1  0  4  cmosn  l= 9.u  w= 9.u  nrd= 1.  nrs= 1. 
dut d ( \2 , \1 , \0 , \4 );

spice

Vgs   5  0  pwl (0,0 1n,0 2n,4 1,4) DC 3.236734 AC 1
Rg    5  1  1meg
Vds   3  0  0
Rds   2  3  100k
Vbs   4  0  0

.options temp=27 tnom=27
.print op v(2) v(3) gds(d.m1) vdsat(d.m1) von(d.m1)
.op trace iter
.print op v(nodes) iter(0)
.op
.print op i(v*) ps(v*)
.op
.print op id(d.m1) vgs(d.m1) vds(d.m1) vbs(d.m1) vth(d.m1) vdsat(d.m1)
.op
.print op gm(d.m1) gds(d.m1) gmb(d.m1) cbd(d.m1) cbs(d.m1)
.op
.print op cgsovl(d.m1) cgdovl(d.m1) cgbovl(d.m1) cgate(d.m1) region(d.m1)
.op
.print op cgsm(d.m1) cgdm(d.m1) cgbm(d.m1) vgst(d.m1) von(d.m1)
.op
.print op cgst(d.m1) cgdt(d.m1) cgbt(d.m1) is(d.m1) ig(d.m1) ib(d.m1)
.op
.print op cqgs(d.m1) cqgd(d.m1) cqgb(d.m1) cqbd(d.m1) cqbs(d.m1)
.op
.print op p(d.m1) pd(d.m1) ps(d.m1) ids(d.m1) idstray(d.m1) iderror(d.m1)
.op
.print op vdm(d.m1) vgm(d.m1) vbm(d.m1) vsm(d.m1)
.op
.print op vd(d.m1) vg(d.m1) vb(d.m1) vs(d.m1)
.op
.print ac v(5) vr(1) vi(1)
* .tran 1p
.ac dec 1 1k 1g
*>.print op gds(d.m1) cgsm(d.m1) iter(0)
*>.op 0 100 25
*>.ac dec 1 1k 1g
.print tran v(5) v(1)
* qgb(d.m1) i(d.m1._b_ddt*) vgst(d.m1)
.tran 30n 1n
*>.ac dec 1 1k 1g
.status notime
.end
