attach ./modelgen_2.so
load vams/vpulse.so
options method=euler
options trtol=1

verilog

`modelgen test_logic_4
module test(a, b);
	logic a;
	logic b;
	input b;
	inout a;

	(*desc="cnt"*) integer cnt;
	(*desc="st"*) real st = 0;
	always @(posedge(b)) begin
		if(a) cnt = cnt + 1;
	end
endmodule

list

!make test_logic_4.so > /dev/null
attach ./test_logic_4.so

test #() dut(en , clk );
resistor #(.r(1k)) dut(\1 ,\2 );
capacitor #(.c(5f)) dut(\2 , gnd);


ground gnd
vpulse #(.val0(0) .val1(5) .width(100p) .period(200p)) v1(aclk, gnd);
vpulse #(.val0(0) .val1(5), .td(.49n)) v1(aen, gnd);
nand #(20) n1(clk, aclk);
and #(20) n1(en, aen);

.model logic logic delay=1p rise=10p fall=15p

list

print tran l(clk) l(en) cnt(dut) iter(0)
tran 1n .1n basic
status notime
end
