
attach ./modelgen_1.so
attach ../vams/vsine.so

verilog

`modelgen
module test_evt_cnt1(p, n);
	electrical p, n;
	inout p, n;
	real t;
	(*desc=""*) real up;
	(*desc=""*) real dn;
	(*desc=""*) real cr;
	(*desc=""*) real ab;
	(*desc=""*) real bl;
	analog begin
		@(cross(V(p,n)+1e-12, 0)) cr = cr + 1;
		@(cross(V(p,n)+1e-12, 1)) up = up + 1;
		@(cross(V(p,n)+1e-12,-1)) dn = dn + 1;
		@(above(V(p,n)+1e-12)) ab = ab + 1;
		@(above(V(n,p)-1e-12)) bl = bl + 1;
	end
endmodule

list

!make test_evt_cnt1.so > /dev/null
attach ./test_evt_cnt1.so

test_evt_cnt1 d (\1 ,\0 );
vsine #(.freq(1e6) .ampl(2) .samples(9)) vin(\1 ,\0 );

list

print tran v(nodes) cr(d) up(d) dn(d) ab(d) bl(d) iter(0)
tran 2e-6 basic

status notime
end
