// pmos al gate
attach ../vams/mosfet.so
attach ../vams/diode.so
*options trace

verilog

paramset ppp mosfet;
  parameter real l = 9.u;
  parameter real w = 9.u;
 .l = l;
 .w = w;
 .polarity = -1;

 .level=1;
 .lambda=0.;
 .rd=0.; .rs=0.;
 .cbd=0.; .cbs=0.;
 .is=10.E-15;
 .pb=0.8;
 .cgso=0.; .cgdo=0.; .cgbo=0.;
 .rsh=0.;
 .mj=0.5;
 .cjsw=0.; .mjsw=0.33; .js=0.;
 .tox=100.n;
 .nsub=4.E+18;
 .nss=0.;
 .tpg=0.;
 .xj=1.E-15;
 .ld=0.;
 .uo=600.;
 .kf=0.;
 .af=1.;
 .fc=0.5;
endparamset;

module dut(d g s b);
  ppp #(.l(9.u),.w(9.u)) m1 ( d g s b);
endmodule

dut d ( \2 , \1 , \0 , \0 );

spice
Vgs   1  0  -1.
Vds   2  0  -1.
.print op v(nodes)
.op
.status notime
.end
