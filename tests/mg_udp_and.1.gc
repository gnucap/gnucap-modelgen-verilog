
load ./modelgen_1.so
load vams/vpulse.so

`modelgen test_myand0
module test_myand0
endmodule

primitive myand0 (y, a, b);
output out;
input in1;
table
        0 0: 0;
        1 0: 0;
        0 1: 0;
        1 1: 1;
endtable
endprimitive
`endmodelgen

!make test_myand0.so >/dev/null
attach ./test_myand0.so

module test(y, a, b);
  // ground \0 ;
  vpulse #(.val0(0) .val1(5) .width(.2) .period(.5)) v1(a, \0 );
  vpulse #(.val0(0) .val1(5), .td(.1) .width(.2) .period(.5)) v1(b, \0 );
  myand0 #10000 b(.y(y), .a(a), .b(b));
endmodule

spice
.model logic logic
.verilog

test #() t(y, a, b)

list

print op v(nodes)
op

print tran v(nodes) l(nodes)
tran 1 trace n
status notime
