verilog

attach ./modelgen_1.so

`modelgen
module test_rdist_tern(p, n)
	electrical p,n;
	inout p,n;
	parameter integer seed = 1;
	parameter integer mm_ok = 1;
	localparam real r
           = (1 + $rdist_normal(seed, 0., 1.) * (mm_ok != 1 ? 0 : 1));

	resistor #(.r(r)) r0(p,n);
	resistor #(.r(r)) r1(p,n);

	resistor #(.r(1 + $rdist_normal(seed, 0., 1.) * (mm_ok != 1 ? 0 : 1))) r2(p,n);
	resistor #(.r(1 + $rdist_normal(seed, 0., 1.) * (mm_ok != 1 ? 0 : 1))) r3(p,n);
endmodule
`endmodelgen

!make test_rdist_tern.so > /dev/null
attach ./test_rdist_tern.so

parameter s=3;
test_rdist_tern #(.seed(s)) tt(gnd, n4);

print dc r(tt.r*)
dc
dc s 1 5 1

options seed=17
dc s 1 5 1

options seed=0
dc s 1 5 1
