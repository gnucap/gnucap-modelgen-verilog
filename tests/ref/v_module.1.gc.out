// test current port in instance
ground gnd;
module main0 (.\1 (\1 ),.\2 (\2 ),.\3 (\3 ),.\4 (\4 ));
    parameter R=1;
  ccvs #(.gain(R)) vs1 (\3i , \2 , vp2);
  vsource #(.dc(0)) vp1 (\3 , \3i );
  ccvs #(.gain(R)) vs2 (\1 , \4i , vp1);
  vsource #(.dc(0)) vp2 (\4 , \4i );
endmodule // main0

// same without current ports...
module main1 (.\1 (\1 ),.\2 (\2 ),.\3 (\3 ),.\4 (\4 ));
    parameter R=1;
  vccs #(1/R) cs1 (\2 , \3 , \4 , \1 );
  vccs #(1/R) cs2 (\1 , \4 , \2 , \3 );
endmodule // main1

main0 #(.R(.34)) m (.\1 (A),.\2 (B),.\3 (gnd),.\4 (gnd));
main1 #(.R(.34)) m (.\1 (C),.\2 (D),.\3 (gnd),.\4 (gnd));
#           v(A)       v(B)       v(C)       v(D)       v(gnd)    
 27.        0.         0.         0.         0.         0.        
*// test current port in instance
ground gnd;
.subckt main0 ( 1 2 3 4 )
  parameter R=1;
vs1 ( 3i 2 vp2 )  ccvs  gain=R
vp1 ( 3 3i )  vsource  dc=0
vs2 ( 1 4i vp1 )  ccvs  gain=R
vp2 ( 4 4i )  vsource  dc=0
.ends main0
*// same without current ports...
.subckt main1 ( 1 2 3 4 )
  parameter R=1;
cs1 ( 2 3 4 1 )  vccs  =1/R
cs2 ( 1 4 2 3 )  vccs  =1/R
.ends main1
m ( A B gnd gnd )  main0  R=.34
m ( C D gnd gnd )  main1  R=.34
.ground gnd 
R1 ( 1 A )  500.
V1 ( 1 0 ) sin offset=NA( 0.) amplitude= 1. frequency= 1.K delay=NA( 0.) damping=NA( 0.)  AC  1.
L1 ( 0 B )  1.u
R1 ( 1 C )  500.
V1 ( 1 0 ) sin offset=NA( 0.) amplitude= 1. frequency= 1.K delay=NA( 0.) damping=NA( 0.)  AC  1.
L1 ( 0 D )  1.u
