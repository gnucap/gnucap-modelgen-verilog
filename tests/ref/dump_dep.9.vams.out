module dep0(d, g);
  inout d, g;
  electrical d, g;
  real S// -
;
  real T// -
;

  analog begin // always
    // S : 0
    // T : 0
    T = 1; // s1 r5{abevx}
    S = 2; // s1 r5{abevx}
    if (analysis("static")) begin
      $strobe("%f", T); // s1 r5{abevx}
    end
    else begin
      $strobe("%f", S); // s1 r5{abevx}
    end
  end

endmodule



