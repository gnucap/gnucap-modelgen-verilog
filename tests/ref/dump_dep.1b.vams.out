module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 0
    // T : 1
    // U : 1
    real T// +
;
    real S// *
;
    real U// +
;
    T = T; // [V(g)] s4 r3
    U = T; // [V(g)] s5 r3
    while (1) begin
      // S : 1
      // T : 1
      S = T; // [V(g)] s5 r3
      T = V(g); // [V(g)] s1 r3
    end
    T = T; // [V(g)] s4 r3
  end

endmodule



