>>>>>list 
(* desc="res1" *) paramset res resistor;
  parameter string what from '{"one", "ONE"}; 
 .r=1;
endparamset

(* desc="res2" *) paramset res resistor;
  parameter string what from '{"two", "TWO"}; 
 .r=2;
endparamset

module main (.\1 (\1 ),.\2 (\2 ),.\3 (\3 ),.\4 (\4 ));
  isource #(1.) v (\1 ,\3 );
  isource #(1.) v (\1 ,\4 );
  res #(.what("one")) R1 (\3 ,\1 );
  res #(.what("TWO")) R1 (\4 ,\1 );
endmodule // main

main #() m (.\1 (\0 ),.\2 (\1 ),.\3 (\2 ),.\4 (\4 ));
