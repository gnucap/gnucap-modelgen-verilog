module device(p, n);
  inout p, n;
  parameter real c =  1.0;
  localparam real l1 = (c + 5);
  parameter real d =  1.0, e = 2;
  parameter integer i = 0, j = 10;
  localparam real t1 = exp(l1);

  analog begin
  end

endmodule
module device(p, n);
  inout p, n;
  parameter real c =  1.0 from [ 0.0: inf);
  parameter real d =  1.0 from [ 1.0: 2.0] exclude 3.;
  parameter real e =  1.0 from [ 0.0: inf), f = 3;

  aliasparam g = c;
  aliasparam h = e;
  aliasparam m = $mfactor;

endmodule



