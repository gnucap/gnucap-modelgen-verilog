>>>>>discipline disc1;
>>>>>discipline disc2;
>>>>>discipline disc2;
>>>>>discipline disc3;
>>>>>connectmodule cm0(out, in);
>>>>>  hybrid out, another;
>>>>>connectmodule cm1(out, in);
>>>>>connectmodule cm2(out, in);
>>>>>connectrules foo;
>>>>>list
discipline disc1;
enddiscipline;
discipline disc2;
enddiscipline;
discipline disc2;
enddiscipline;
discipline disc3;
enddiscipline;
module cm0 (.out(out),.in(in));
  disc1 in;
  hybrid out;
  hybrid another;
  output out;
  input in;
endmodule // cm0

module cm1 (.out(out),.in(in));
  output out;
  input in;
endmodule // cm1

module cm2 (.out(out),.in(in));
  output out;
  input in;
endmodule // cm2

connectrules foo ();
   connect disc1 disc2 resolveto disc3;
  connect cm0;
  connect cm1 merged;
  connect cm2 split;
endmodule // foo

>>>>>`disciplines
discipline disc1;
enddiscipline
discipline disc2;
enddiscipline
discipline disc2:0;
enddiscipline
discipline disc3;
enddiscipline
discipline electrical;
enddiscipline
discipline hybrid;
enddiscipline
discipline logic;
enddiscipline
>>>>>delete disc2
