module test_state(a, c);
  inout a, c;
  electrical a, c;
  electrical ia;
  parameter integer init = 0;

  real vv// *
;

  analog   initial begin // i
    // vv : 0
    vv = init; // s1 r3{bax}
  end

  analog begin // always
    // vv : 0
    V(a, c) <+ transition(vv); // [V(transition_0_p)] r2{x}
    vv = (vv + 1); // s3 r3{bax}
  end

endmodule



