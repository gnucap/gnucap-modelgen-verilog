module dep7(a, g);
  inout a, g;
  electrical a, g;
  parameter real p =  0.;

  real T//
;

  analog begin : main // always
    // c : 1
    // d : 0
    real c// + [V(a)]
, d// * [V(a)]
;
    c = V(a); // [V(a)] s1 r4{bax}
    if ((V(g) > 1)) begin : b0
      // t : 0
      real t// *
;
      t = 4; // s1 r3{bax}
    end
    else begin
      // d : 1
      d = c; // [V(a)] s2 r4{bax}
    end
    begin : stuff
    // b1
      if ((c > 0)) begin : b1
        // f : 1
        real f// * [V(a)]
;
        I(g) <+ d; // [V(a)] s3 r1{}
        f = d; // [V(a)] s4 r3{bax}
      end
      else begin
        I(g) <+ 1; // r1{}
      end
    end
  end

endmodule



// paramsets
module dep7p(a, g);
  electrical a, g;
  localparam real __p =  0.;

  real __T//
;

  analog begin : main // always
    // c : 1
    // d : 0
    real c// + [V(a)]
, d// * [V(a)]
;
    c = V(a); // [V(a)] s1 r4{bax}
    if ((V(g) > 1)) begin : b0
      // t : 0
      real t// *
;
      t = 4; // s1 r3{bax}
    end
    else begin
      // d : 1
      d = c; // [V(a)] s2 r4{bax}
    end
    begin : stuff
    // b1
      if ((c > 0)) begin : b1
        // f : 1
        real f// * [V(a)]
;
        I(g) <+ d; // [V(a)] s3 r1{}
        f = d; // [V(a)] s4 r3{bax}
      end
      else begin
        I(g) <+ 1; // r1{}
      end
    end
  end

endmodule

