module dep6(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 0
    // T : 0
    // U : 0
    // c : 0
    real c// *
;
    real T// +
, S//
, U//
;
    @(initial_step) begin // e
      // c : 0
      c =  1.; // s2 r3{bax}
    end
    @(initial_step) begin // e
      // c : 0
      c =  2.; // s2 r3{bax}
    end
    T = c; // s6 r3{bax}
    S = (T * T); // s7 r3{bax}
    U = exp(c); // s6 r3{bax}
  end

endmodule



