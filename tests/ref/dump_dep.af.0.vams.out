module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog function real testaf;
    real a//
, b//
;
    input a;
    inout b;
    // arg 0 a 0
    // arg 1 b 1 dep a
    begin // always
      // b : 1
      // testaf : 1
      b = a; // [a] s1 r3{bax}
      testaf = a; // [a] s1 r3{bax}
    end
  endfunction

  analog begin : main // always
    // a : 0
    // b : 0
    // c : 0
    real a// + [V(g)]
;
    real b// *
;
    real c// + [V(g)]
;
    begin
    // a : 1
    // c : 1
      a = V(g); // [V(g)] s1 r4{bax}
      c = testaf(a, b); // [V(g)] s3 r4{bax}
      I(d) <+ b; // s1 r1{}
      I(g) <+ c; // [V(g)] s3 r1{}
    end
  end

endmodule



