module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog function real testaf;
    real a, b;
    input a;
    inout b;
    begin // always
      // b : 0
      // testaf : 0
      b = a; // s1 r3
      testaf = a; // s1 r3
    end
  endfunction

  analog begin : main // always
    // a : 0
    // b : 0
    // c : 0
    real a;
    real b;
    real c;
    begin
    // a : 1
    // c : 1
      a = V(g); // dep: _potential_b_g_ s1 r4
      c = testaf(a, b); // dep: _potential_b_g_ s3 r4
      I(d) <+ b; // s1 r1
      I(g) <+ c; // dep: _potential_b_g_ s3 r1
    end
  end

endmodule



