module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog function real testaf;
    real a// [] 
, b// [] 
;
    input a;
    inout b;
    // arg 0 a 0
    // arg 1 b 1 dep a
    begin // always
      // b : 1
      // testaf : 1
      b = a; // dep: a s1 r3
      testaf = a; // dep: a s1 r3
    end
  endfunction

  analog begin : main // always
    // a : 0
    // b : 0
    // c : 0
    real a// [] +
;
    real b// [] *
;
    real c// [] +
;
    begin
    // a : 1
    // c : 1
      a = V(g); // dep: V(g) s1 r4
      c = testaf(a, b); // dep: V(g) s3 r4
      I(d) <+ b; // s1 r1
      I(g) <+ c; // dep: V(g) s3 r1
    end
  end

endmodule



