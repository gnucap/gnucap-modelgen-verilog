

module test(d, g, s, b);
  parameter real P = 3;

  real T, U;

  electrical #() d();
  g #() ();
  analog begin
    T = (0 * P);
    T = (0 * U);
    T = ((( 2.0 * U) *  3.0) /  5.0);
    T = ((( 2.0 * P) *  3.0) /  5.0);
    T = (((( 2.0 * U) *  3.0) /  5.0) * ln(( 1.0 + ( 400.0e-9 / T))));
    T = (((( 2.0 * P) *  3.0) /  5.0) * ln(( 1.0 + ( 400.0e-9 / T))));
  end

endmodule



