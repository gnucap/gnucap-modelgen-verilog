// paramsets
module my_res(a, b);
  electrical a, b;
  parameter real g = 1;
  localparam real __r = ( 1. / g);

  real __i// + [V(a, b)]
;

  analog begin // always
    // __i : 1
    begin // always
      // __i : 0
      __i =  3.; // s1 r3{abx}
      begin // always
        // __i : 1
        __i = V(a, b); // [V(a, b)] s1 r3{abx}
      end
    end
    __i = __i; // [V(a, b)] s4 r3{abx}
  end

endmodule

