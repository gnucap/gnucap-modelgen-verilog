endmodule // hsp

module main (.\1 (\1 ),.\2 (\2 ));
  ground \0 ; 
  hsp #((* test=2 *) .$xposition(3),(* test=3 *) .$mfactor(2)) test (\1 ,\0 );
endmodule // main

