module dep_test(d, g);
  inout d, g;
  electrical d, g;
  parameter integer sel = 0 from [0:2];

  analog begin : main // always
    // c : 0
    real c// +
;
    case (sel)
      0: begin
        // c : 0
        c = 1; // s1 r4{bax}
      end
      1: begin
        // c : 0
        c = sel; // s1 r4{bax}
      end
      default: begin
        // c : 0
        c = 17; // s1 r4{bax}
      end
    endcase
    I(d) <+ c; // s5 r2{x}
    c = 4; // s1 r4{bax}
  end

endmodule



