module device(a, c);
  inout a, c;
  electrical a, c;
  parameter real s = 1;

  real gg// +
;
  real hh// +
;
  real ii// -
;
  real jj// -
;

  analog begin // always
    // gg : 0
    // hh : 0
    // ii : 0
    // jj : 0
    gg = $simparam("gmin",  0.); // s1 r4{bax}
    hh = $simparam("gmin"); // s1 r4{bax}
    ii = $simparam("scale", s); // s1 r4{bax}
    jj = $simparam("scale"); // s1 r4{bax}
    I(a, c) <+ (gg * hh); // s2 r2{x}
    I(a, c) <+ (ii * jj); // s2 r2{x}
  end

endmodule



