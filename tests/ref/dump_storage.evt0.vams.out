module test_evtana0c(p, n);
  electrical p, n;
  inout p, n;
  integer cnt// *
;
  real v// *
;

  analog begin // always
    if (analysis("static")) begin
      // v : 0
      $debug("static %g\n", $abstime); // r1{x}
      v =  0.4; // s1 r4{abx}
    end
    else begin
      if (0) begin // never
        $trace("not static %g\n", $abstime); // --

      end
      @(timer( 0.0,  0.5)) begin // e
        // cnt : 0
        // v : 0
        v = 1; // s2 r4{abx}
        cnt = (cnt + 1); // s3 r3{abx}
      end
    end
    V(p, n) <+ v; // s4 r2{x}
  end

endmodule



