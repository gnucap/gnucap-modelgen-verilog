module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 1
    // T : 0
    // c : 0
    // k : 0
    real c// + [V(g)]
;
    real T// [V(g)]
;
    real S// + [V(g)]
;
    integer k// +
;
    S = V(g); // [V(g)] s1 r3{abx}
    k = 10; // s1 r3{abx}
    while (k) begin
      // T : 1
      // c : 0
      // k : 0
      c = S; // [V(g)] s2 r3{abx}
      T = c; // [V(g)] s3 r3{abx}
      c = 0; // s1 r3{abx}
      k = (k - 1); // s2 r3{abx}
    end
  end

endmodule



