module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 1
    // T : 0
    // c : 0
    // k : 0
    real c// *
;
    real T// *
;
    real S// +
;
    integer k// +
;
    S = V(g); // [V(g)] s1 r3
    k = 10; // s1 r3
    while (k) begin
      // T : 1
      // c : 0
      // k : 0
      c = S; // [V(g)] s2 r3
      T = c; // [V(g)] s3 r3
      c = 0; // s1 r3
      k = (k - 1); // s2 r3
    end
  end

endmodule



