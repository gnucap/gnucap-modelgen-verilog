module foo(p, x);
  inout p;
  electrical p;
  electrical x;
  real A// -
, B// +
;
  real y// + [V(p)]
;

  analog begin : main // always
    // A : 0
    // B : 0
    // C : 0
    // y : 0
    real C// +
;
    A = 1; // s1 r5
    B = A; // s2 r5
    C = B; // s3 r5
    $strobe("some strobe %f.", (C + V(x))); // [V(x)] s3 r5
    y = V(p); // [V(p)] s1 r5
    $strobe("some strobe %f.", y); // [V(p)] s1 r5
    $finish(1); // c
    y = 0; // s1 r3
  end

endmodule



