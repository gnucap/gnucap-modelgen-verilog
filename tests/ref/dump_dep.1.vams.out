module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 1
    // T : 0
    // c : 0
    real c// *
;
    real T// *
;
    real S// +
;
    S = T; // s3 r3
    while (1) begin
      // T : 1
      // c : 1
      c = T; // [V(g)] s3 r3
      T = V(g); // [V(g)] s1 r3
    end
    S = T; // [V(g)] s3 r3
  end

endmodule



