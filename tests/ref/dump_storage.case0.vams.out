module dep_test(d, g);
  inout d, g;
  electrical d, g;
  parameter integer sel = 0 from [0:1];

  analog begin : main // always
    // c : 0
    real c// *
;
    case (sel)
      0: begin
        // c : 0
        c = 1; // s1 r4{abx}
      end
      1: begin
        // c : 0
        c = sel; // s1 r4{abx}
      end
    endcase
    I(d) <+ c; // s4 r2{x}
    c = 4; // s1 r4{abx}
  end

endmodule



