module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 0
    // T : 1
    // U : 1
    // X : 1
    real T// *
;
    real S// *
;
    real U// +
;
    real X// +
;
    while (1) begin
      // S : 1
      // T : 1
      T = T; // [V(g)] s7 r3
      S = T; // [V(g)] s7 r3
      T = V(g); // [V(g)] s1 r3
    end
    U = S; // [V(g)] s6 r3
    T = U; // [V(g)] s7 r3
    X = U; // [V(g)] s7 r3
  end

endmodule



