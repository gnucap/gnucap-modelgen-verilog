module dep0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // S : 0
    // T : 1
    // U : 1
    // X : 1
    real T// * [V(g)]
;
    real S// + [V(g)]
;
    real U// + [V(g)]
;
    real X// [V(g)]
;
    while (1) begin // always
      // S : 1
      // T : 1
      T = T; // [V(g)] s7 r3{abx}
      S = T; // [V(g)] s7 r3{abx}
      T = V(g); // [V(g)] s1 r3{abx}
    end
    U = S; // [V(g)] s6 r3{abx}
    T = U; // [V(g)] s7 r3{abx}
    X = U; // [V(g)] s7 r3{abx}
  end

endmodule



