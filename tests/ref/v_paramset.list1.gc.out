paramset testvs vsource;
  parameter real p;
 .dc=(p + 1);
endparamset

module dut (.p(p));
  ground g;
  parameter real \fred! = 3.;
  testvs #(.p(3)) v1 (p, g);
  testvs #(.p((3*\fred! )+2)) v1 (p, g);
endmodule // dut

dut #() d (p);
paramset testvs vsource;
  parameter real p;
 .dc=(p + 1);
endparamset

module dut (.p(p));
  ground g;
  parameter real \fred! = 3.;
  testvs #(.p(3)) v1 (p, g);
  testvs #(.p((3*\fred! )+2)) v1 (p, g);
endmodule // dut

dut #() d (.p(p));
#           v(p)      
 0.         8.        
