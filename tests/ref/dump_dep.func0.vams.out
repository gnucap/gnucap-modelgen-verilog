module dep_tern0(d, g);
  inout d, g;
  electrical d, g;
  analog begin : main // always
    // T : 1
    // c : 1
    real c// + [V(d)]
;
    real T// + [V(g)]
;
    c = V(d); // [V(d)] s1 r4{bax}
    T = V(g); // [V(g)] s1 r4{bax}
    I(d) <+ pow(T, c); // [V(g), V(d)] s2 r2{x}
  end

endmodule



