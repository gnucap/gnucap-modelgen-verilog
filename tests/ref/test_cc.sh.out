/*--------------------------------------------------------------------------*/
#if __cplusplus >= 202002L
int COMMON_resistor::operator<=>(const COMMON_COMPONENT& x) const
{
  if(this == &x){
    return 0;
  }else{
  }
  std::type_index a(typeid(*this));
  std::type_index b(typeid(x));
  if(a < b){
    return -1;
  }else if(a > b){
    return 1;
  }else{
  }
  int c;
  if((c = COMMON_COMPONENT::compare(x))){
    return c;
  }else{
  }
  auto p = prechecked_cast<const COMMON_resistor*>(&x);
  assert(p);
  if((c = _p_r.compare(p->_p_r))){
    return c;
  }else if(_p___r < p->_p___r) {
    return -1;
  }else if(_p___r > p->_p___r) {
    return 1;
  }else if(_p___tc1 < p->_p___tc1) {
    return -1;
  }else if(_p___tc1 > p->_p___tc1) {
    return 1;
  }else if(_p___tc2 < p->_p___tc2) {
    return -1;
  }else if(_p___tc2 > p->_p___tc2) {
    return 1;
  }else if(_p___noisy < p->_p___noisy) {
    return -1;
  }else if(_p___noisy > p->_p___noisy) {
    return 1;
  }else if(_p___tnom < p->_p___tnom) {
    return -1;
  }else if(_p___tnom > p->_p___tnom) {
    return 1;
  }else {
  }
if(double tt = _temp_k - p->_temp_k){
  return tt>0?1:-1;
}
  auto ord = _v_ <=> p->_v_;
  if(ord == std::weak_ordering::equivalent){
    return 0;
  }else if(ord == std::weak_ordering::less){
    return -1;
  }else if(ord == std::weak_ordering::greater){
    return 1;
  }else{untested();
    unreachable()
    return 0;
  }
}
/*--------------------------------------------------------------------------*/
#else
int COMMON_resistor::compare(const COMMON_COMPONENT& x)const
{
  const COMMON_resistor* p = dynamic_cast<const COMMON_resistor*>(&x);
  assert (p);
  if(this == &x){
    return 0;
  }else{
  }
if(double tt = _temp_k - p->_temp_k){
  return tt>0?1:-1;
}
  return 0;
}
/*--------------------------------------------------------------------------*/
bool COMMON_resistor::operator==(const COMMON_COMPONENT& x)const
{
  const COMMON_resistor* p = dynamic_cast<const COMMON_resistor*>(&x);
  return (p
    && _p_r == p->_p_r
    && _p___r == p->_p___r
    && _p___tc1 == p->_p___tc1
    && _p___tc2 == p->_p___tc2
    && _p___noisy == p->_p___noisy
    && _p___tnom == p->_p___tnom
#if __cplusplus >= 202002L
    && _v_ == p->_v_
#endif
    && !compare(*p)
    && COMMON_COMPONENT::operator==(x));
}
