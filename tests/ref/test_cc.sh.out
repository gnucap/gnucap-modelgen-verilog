/*--------------------------------------------------------------------------*/
// seq blocks
/*--------------------------------------------------------------------------*/
bool MOD_capacitor::tr_needs_eval()const
{
  trace3("capacitor::needs_eval?", long_label(), _sim->_time0, has_probes());
  node_t gnd(&ground_node);
  if (is_q_for_eval()) {
    trace3("capacitor::needs_eval?", long_label(), _sim->_time0, is_q_for_eval());
    return false;
  }else if (!converged()) {
    return true;
  }else if (has_probes()) {
    return true;
  }else   if(_sim->is_first_iteration()){
    return true;
  }else if( !conchk(_potential_b_p_n, n_(n_p).v0() - n_(n_n).v0(), 1e-6)){
    return true;
  }else{
    return false;
  }
};
