inline void MOD_capacitor::read_probes()
{
  trace0("capacitor::read_probes");
  node_t gnd(&ground_node);
  // filter _b_ddt_2_p_
  _potential_b_p_n = volts_limited(n_(n_p), n_(n_n));
}
