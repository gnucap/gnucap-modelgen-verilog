class MOD_capacitor : public BASE_SUBCKT {
  typedef MOD_capacitor MOD;
  typedef COMMON_capacitor COMMON;
private:
  bool _accept{false};
public:
  typedef ddouble_<2> ddouble;
  enum {
    d_potential_b_ddt_1_p_,
    d_potential_b_p_n,
     num_branches__  };
private: // data
  mutable node_t _nodes[3];
public: // netlist
  ELEMENT* _b_ddt_1_p_{nullptr}; // filter
  ELEMENT* _b_p_n{nullptr}; // branch
private: // func decl
//other: $param_given
//other: analysis
//filt ddt_1
  ddouble _b_ddt_1(ddouble t0);
  bool _short_b_ddt_1()const {return 1;}
  ddouble _b_ddt_1precalc(ddouble){
    ddouble ret(0.);
    /* short, mfactor hack */ ret[d_potential_b_ddt_1_p_] = 1.;
    return ret;
  }
  double _b_ddt_1tr_begin(ddouble t0){
    (void)t0;
    return 0.;
  }
  ddouble _b_ddt_1tr_eval(ddouble t0){
    return _b_ddt_1(t0);
  }
  ddouble _b_ddt_1tr_advance(ddouble t0){
    // subdevice
    t0 = 0.;
    return t0;
  }
  ddouble _b_ddt_1tr_regress(ddouble t0){
    return _b_ddt_1tr_advance(t0);
  }
  double _b_ddt_1tr_restore(ddouble t0){
    (void)t0;
    return 0.;
  }
  ddouble _b_ddt_1tr_accept(ddouble t0) {
    (void)t0;
    typedef MOD_capacitor MOD;
    // subdevice
    t0 = 0.;
    assert(t0 == t0);
    return t0;
  } // ddt tr_accept
  double _b_ddt_1tr_review(ddouble){
    return 0.;
  } // ddt tr_review
//probe potential_ddt_1_p_
  ddouble xs_potential_b_ddt_1_p_() const { // potential_ddt_1_p_
    ddouble t;
      t = 0.;
    return t;
  }
//probe potential_p_n
  ddouble xs_potential_b_p_n() const { // potential_p_n
    ddouble t;
    t = _potential_b_p_n; // unnamed
    t[d_potential_b_p_n] = 1; // unnamed
    return t;
  }
private: // construct
  explicit MOD_capacitor(MOD_capacitor const&);
public:
  explicit MOD_capacitor(); // : BASE_SUBCKT() { _n = _nodes; }
  CARD* clone()const override;
private: // overrides
  int is_valid()const override;
  void precalc_first()override;
  void expand()override;
  void precalc_last()override;
  void zero_filter_readout();
  //void    map_nodes();         //BASE_SUBCKT
  //void    tr_restore();        //BASE_SUBCKT
  void    tr_load()override{ trace1("tr_load", long_label());BASE_SUBCKT::tr_load();}
  TIME_PAIR  tr_review()override;
  void tr_accept()override;
  void q_accept() { _accept = 1; }
  void tr_advance()override;
  void tr_regress()override;
  //void    tr_unload();         //BASE_SUBCKT
  void      dc_advance()override {set_not_converged(); BASE_SUBCKT::dc_advance();}
  bool      tr_needs_eval()const override;
  void      tr_queue_eval()override {if(tr_needs_eval()){q_eval();}else{} }
  bool      do_tr() override;
  void ac_final()override {}
  void dc_final()override {}
  void tr_final()override {}
  double tr_probe_num(std::string const&)const override;
    //void    ac_load();           //BASE_SUBCKT
    //XPROBE  ac_probe_ext(CS&)const;//CKT_BASE/nothing
  std::string dev_type()const override {return "capacitor";}
  int max_nodes()const override {return 2;}
  int min_nodes()const override {return 0;}
  int int_nodes()const override    {return 1;}
  std::string value_name()const override {itested(); return "";}
  bool print_type_in_spice()const override {itested(); return false;}
  std::string port_name(int i)const override;
  node_t& n_(int i)const override {
    assert(_nodes); assert(i>=0); assert(i<3); return _nodes[i];
  }
private: // impl
/* ========== */
public: // instance vars
  struct state_{
#if __cplusplus >= 202002L
    constexpr std::partial_ordering operator<=>(state_ const&)const = default;
#endif
  }_v_;
  state_ _v_1;
private: // branch state
public: // states, _b_ddt_1_p_;
  double _value_b_ddt_1_p_;
  double _st_b_ddt_1_p_  [3]; // (s)
  struct _st_b_ddt_1_p__ {
    enum {     VALUE, SELF, dep_potential_b_p_n/* : */
    };
  } _dep_b_ddt_1_p_;
public: // states, _b_p_n;
  double _value_b_p_n;
  double _st_b_p_n  [2]; // (s)
  struct _st_b_p_n_ {
    enum {     VALUE, SELF/* : */
    };
  } _dep_b_p_n;
private: // node list
  enum {
    n_p /* used: 1 */,
    n_n /* used: 1 */,
    n_ddt_1_p /* used: 0 */
  };
private: // probe values
  double _potential_b_ddt_1_p_{0.};
  double _potential_b_p_n{0.};
private: // impl
  void read_probes();
  void set_branch_contributions();
  void clear_branch_contributions();
  friend class COMMON_capacitor;
  friend class PRECALC_capacitor;
}; // m_capacitor;
