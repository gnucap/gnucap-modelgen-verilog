/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::set_branch_contributions()
{
    { // 1
    assert(_value_b_p_n == _value_b_p_n);
    _st_b_p_n[0] = _value_b_p_n;
    // sources...
      { // set state 
      long double sp = 0.;
      // _potential_b_ddt_2_p_ lin: 1
      sp += (long double)(_st_b_p_n[_st_b_p_n_::dep_potential_b_ddt_2_p_] * _potential_b_ddt_2_p_);
      _st_b_p_n[0] = double(_st_b_p_n[0] - sp);
      }
    }
  // pot src (p, n)
  if(!_b_p_n){
  }else if(_pot_b_p_n){
    _b_p_n->_loss0 = 1./OPT::shortckt;
  }else{
    _b_p_n->_loss0 = 0.; // AA
  }
}
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::clear_branch_contributions()
{
    _pot_b_p_n = false;
    _value_b_p_n = 0.;
    std::fill_n(_st_b_p_n+1, 2, 0.);
}
/*--------------------------------------------------------------------------*/
typedef MOD_capacitor::ddouble ddouble;
inline void COMMON_capacitor::tr_eval_analog(MOD_capacitor* d) const
{
  trace1("capacitor::tr_eval_analog", d->long_label());
  MOD_capacitor const* p = d;
  (void)p;
  assert(p);
  COMMON_capacitor const* pc = this;
  (void)pc;
  (void)d;
  { // AnalogConstruct
// construct block...
    { // anonymous block
      {
        double f0;
        { // scope
          // F analysis args:1
          std::string s0;
          s0 = "ic";
          // --- 
          f0 = _f_analysis(s0); // (659)
        } // scope
        ddouble t0;
        //t0.set_no_deps();
        t0 =  1. && f0; // (703)
        if (t0) {
          { // anonymous block
            { // Contribution V(p, n) lin: 1
              ddouble t0;
              //t0.set_no_deps();
              t0 = (_p___ic) /*rhspar*/; // tr_eval
              if (!d->_pot_b_p_n){
                d->_pot_b_p_n = true;
                d->_value_b_p_n = 0.;
                std::fill_n(d->_st_b_p_n+1, 2, 0.);
              }else{
              }
              d->_value_b_p_n /* contrib sign: */ += t0.value(); // (342)
            }
          }
        }else {
          { // anonymous block
            { // Contribution I(p, n) lin: 1
              ddouble t0;
              //t0.set_no_deps();
              //t0[d_potential_b_ddt_2_p_] = 0.; // (output dep)
              { // scope
                // F ddt args:1
                ddouble t1;
                //t1.set_no_deps();
                //t1[d_potential_b_ddt_2_p_] = 0.; // (output dep)
                t1.set_no_deps();
                t1 = p->xs_potential_b_p_n();
                t1 = (_p___c) /*rhspar*/ * t1; // (703)
                // --- 
                t0 = /*tr_eval*/ d->_b_ddt_2tr_eval(t1); // (659)
              } // scope
              if (d->_pot_b_p_n){
                d->_pot_b_p_n = false;
                d->_value_b_p_n = 0.;
                std::fill_n(d->_st_b_p_n+1, 2, 0.);
              }else{
              }
              d->_value_b_p_n /* contrib sign: */ += t0.value(); // (342)
              // dep _potential_b_ddt_2_p_
              assert(t0[d_potential_b_ddt_2_p_] == t0[d_potential_b_ddt_2_p_]);
              d->_st_b_p_n[MOD::_st_b_p_n_::dep_potential_b_ddt_2_p_] += t0[d_potential_b_ddt_2_p_]; // (382)
            }
          }
        }

      }
    }
  }
}
