/*--------------------------------------------------------------------------*/
#if __cplusplus >= 202002L
int COMMON_capacitor::operator<=>(const COMMON_COMPONENT& x) const
{
  if(this == &x){
    return 0;
  }else{
  }
  std::type_index a(typeid(*this));
  std::type_index b(typeid(x));
  if(a < b){
    return -1;
  }else if(a > b){
    return 1;
  }else{
  }
  int c;
  if((c = COMMON_COMPONENT::compare(x))){
    return c;
  }else{
  }
  auto p = prechecked_cast<const COMMON_capacitor*>(&x);
  assert(p);
  if((c = _p_c.compare(p->_p_c))){
    return c;
  }else if((c = _p_ic.compare(p->_p_ic))){
    return c;
  }else if(_p___c < p->_p___c) {
    return -1;
  }else if(_p___c > p->_p___c) {
    return 1;
  }else if(_p___ic < p->_p___ic) {
    return -1;
  }else if(_p___ic > p->_p___ic) {
    return 1;
  }else {
  }
  auto ord = _v_ <=> p->_v_;
  if(ord == std::weak_ordering::equivalent){
    return 0;
  }else if(ord == std::weak_ordering::less){
    return -1;
  }else if(ord == std::weak_ordering::greater){
    return 1;
  }else{untested();
    unreachable()
    return 0;
  }
}
/*--------------------------------------------------------------------------*/
#else
int COMMON_capacitor::compare(const COMMON_COMPONENT& x)const
{
  const COMMON_capacitor* p = dynamic_cast<const COMMON_capacitor*>(&x);
  assert (p);
  if(this == &x){
    return 0;
  }else{
  }
  return 0;
}
/*--------------------------------------------------------------------------*/
bool COMMON_capacitor::operator==(const COMMON_COMPONENT& x)const
{
  const COMMON_capacitor* p = dynamic_cast<const COMMON_capacitor*>(&x);
  return (p
    && _p_c == p->_p_c
    && _p_ic == p->_p_ic
    && _p___c == p->_p___c
    && _p___ic == p->_p___ic
#if __cplusplus >= 202002L
    && _v_ == p->_v_
#endif
    && !compare(*p)
    && COMMON_COMPONENT::operator==(x));
}
/*--------------------------------------------------------------------------*/
#endif
void COMMON_capacitor::set_param_by_index(int I, std::string& Value, int /*Offset*/)
{
  switch (I) {
  case 0:  _p_c = Value; break;
  case 1:  _p_ic = Value; break;
    default: incomplete(); // throw? COMMON_COMPONENT::set_param_by_index(I - 2, Value, Offset + 2);
  }
  (void) Value;
}
/*--------------------------------------------------------------------------*/
int COMMON_capacitor::set_param_by_name(std::string Name, std::string Value)
{
  trace2("spbn capacitor", Name, Value);
  {
  static std::string names[] = {"c", "ic"  };
  int lb = 0;
  int ub = 2;
  while(lb < ub) {
    int mid = (lb+ub)/2;
    int c = std::strcmp(Name.c_str(), names[mid].c_str());
    if(c<0){
      ub = mid;
    }else if(c>0){
      lb = mid+1;
    }else{
      lb = mid;
      ub = 2;
      assert(lb<ub);
      break;
    }
  }
  assert(lb<=ub);
  switch(ub-lb){
    case 2:_p_c = Value;    break; // 0
    case 1:_p_ic = Value;    break; // 0
    case 0: return COMMON_COMPONENT::set_param_by_name(Name, Value);
  }
  return lb;
  }
}
/*--------------------------------------------------------------------------*/
bool COMMON_capacitor::param_is_printable(int I)const
{
  switch (I) {
  case 0:  return (_p_c.has_hard_value());
  case 1:  return (_p_ic.has_hard_value());
// local _p___c
// local _p___ic
  default: return COMMON_COMPONENT::param_is_printable(I - 2);
  }
}
/*--------------------------------------------------------------------------*/
std::string COMMON_capacitor::param_name(int I)const
{
  switch (I) {
  case 0:  return "c";
  case 1:  return "ic";
  default: return COMMON_COMPONENT::param_name(I - 2);
  }
}
/*--------------------------------------------------------------------------*/
std::string COMMON_capacitor::param_name(int I, int j)const
{
  if(j==0){
    return param_name(I);
  }else{
    return "";
  }
}
/*--------------------------------------------------------------------------*/
std::string COMMON_capacitor::param_value(int I)const
{
  switch (I) {
  case 0:  return _p_c.string();
  case 1:  return _p_ic.string();
  default: return COMMON_COMPONENT::param_value(I - 2);
  }
}
/*--------------------------------------------------------------------------*/
int COMMON_capacitor::is_valid() const
{
  COMMON_capacitor const* pc = this;
  (void)pc;
  {
  double lb, ub;
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 = 0; // 
  lb = t0;
  }
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 =  Inf; // 
  ub = t0;
  }
  if(!(lb<=_p_c && _p_c<ub)){
      throw Exception_OutOfRange_("c","from " + to_string(lb) + " .." + to_string(ub));
    }else{
    }
  }
  return true; //COMMON_COMPONENT::is_valid();
}
/*--------------------------------------------------------------------------*/
void COMMON_capacitor::expand(const COMPONENT* d)
{
  COMMON_COMPONENT::expand(d);
}
/*--------------------------------------------------------------------------*/
void COMMON_capacitor::precalc_first(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_COMPONENT::precalc_first(par_scope);
  COMMON_capacitor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_c),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 = 0; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_ic),     def , par_scope);
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_c) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___c = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_ic) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___ic = def;
  }
}
/*--------------------------------------------------------------------------*/
void COMMON_capacitor::precalc_last(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_capacitor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_c),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 = 0; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_ic),     def , par_scope);
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_c) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___c = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_ic) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___ic = def;
  }
  COMMON_COMPONENT::precalc_last(par_scope);
}
