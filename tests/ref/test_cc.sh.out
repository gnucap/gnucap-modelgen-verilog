      // _potential_b_white_noise_1_p_ lin: 1
      _st_b_p_n[0] = double(_st_b_p_n[0] - sp);
      }
    }
  // flow src (p, n)
}
/*--------------------------------------------------------------------------*/
inline void MOD_resistor::clear_branch_contributions()
{
    _value_b_p_n = 0.;
    std::fill_n(_st_b_p_n+1, 1, 0.);
}
