//cc impl
MOD_capacitor::ddouble MOD_capacitor::_b_ddt_2(ddouble t0)
{
  MOD_capacitor* d = this;
  typedef MOD_capacitor MOD;
  d->_st_b_ddt_2_p_[0] = + t0.value();
  // dep _potential_b_p_n
  assert(t0[d_potential_b_p_n] == t0[d_potential_b_p_n]);
  // assert(!d->_st_b_ddt_2_p_[2]);
  d->_st_b_ddt_2_p_[MOD::_st_b_ddt_2_p__::dep_potential_b_p_n]  = + t0[d_potential_b_p_n]; // (4)
  auto e = prechecked_cast<ELEMENT const*>(d->_b_ddt_2_p_);
  assert(e);
  d->_potential_b_ddt_2_p_ = t0 = e->tr_amps(); // (236)
  t0[d_potential_b_ddt_2_p_] = 1.;
  assert(t0 == t0);
  return t0;
}
/*--------------------------------------------------------------------------*/
} // n1
/*--------------------------------------------------------------------------*/
/*--------------------------------------------------------------------------*/
} // tail
