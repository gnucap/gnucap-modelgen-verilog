/*--------------------------------------------------------------------------*/
void COMMON_resistor::precalc_first(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_COMPONENT::precalc_first(par_scope);
  COMMON_resistor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_r),     def , par_scope);
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_r) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___r = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___tc1 = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___tc2 = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___noisy = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___tnom = def;
  }
}
/*--------------------------------------------------------------------------*/
void COMMON_resistor::precalc_last(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_resistor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_r),     def , par_scope);
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_r) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___r = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___tc1 = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___tc2 = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___noisy = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    this->_p___tnom = def;
  }
_temp_k = temp_k(par_scope);
  COMMON_COMPONENT::precalc_last(par_scope);
}
