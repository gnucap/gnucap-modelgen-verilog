/*--------------------------------------------------------------------------*/
inline void MOD_resistor::tr_advance()
{
  COMMON_resistor const* c = prechecked_cast<COMMON_resistor const*>(common());
  assert(c);
  (void)c;
  if(_sim->_phase == p_RESTORE) {untested();
    return;
  }else{
  }
  set_not_converged();
  _v_1 = _v_;
  c->tr_advance_analog(this);
  BASE_SUBCKT::tr_advance();
} // tr_advance
/*--------------------------------------------------------------------------*/
inline void MOD_resistor::tr_regress()
{
  BASE_SUBCKT::tr_regress();
  set_not_converged();
  q_eval();
  if(_sim->_phase == p_RESTORE) {
    return;
  }else{
  }
  COMMON_resistor const* c = prechecked_cast<COMMON_resistor const*>(common());
  assert(c);
  c->tr_regress_analog(this);
}
/*--------------------------------------------------------------------------*/
  std::string MOD_resistor::port_name(int i)const
{
    assert(i >= 0);
    assert(i < max_nodes());
    static std::string names[] = {"p", "n"    };
    return names[i];
  }
/*--------------------------------------------------------------------------*/
MOD_resistor m_resistor;
DISPATCHER<CARD>::INSTALL d0(&device_dispatcher, "resistor", &m_resistor);
/*--------------------------------------------------------------------------*/
CARD* MOD_resistor::clone()const
{
  MOD_resistor* new_instance = new MOD_resistor(*this);
  assert(!new_instance->subckt());
  return new_instance;
}
/*--------------------------------------------------------------------------*/
MOD_resistor::MOD_resistor(MOD_resistor const&p) : BASE_SUBCKT(p)
{
  for (int ii = 0; ii < max_nodes(); ++ii) {
    n_(ii) = p.n_(ii);
    }
}
/*--------------------------------------------------------------------------*/
int MOD_resistor::set_param_by_name(std::string Name, std::string Value)
{
  trace2("spbn resistor", Name, Value);
  {
  static std::string names[] = {"m"  };
  int lb = 0;
  int ub = 1;
  while(lb < ub) {
    int mid = (lb+ub)/2;
    int c = std::strcmp(Name.c_str(), names[mid].c_str());
    if(c<0){
      ub = mid;
    }else if(c>0){
      lb = mid+1;
    }else{
      lb = mid;
      ub = 1;
      assert(lb<ub);
      break;
    }
  }
  assert(lb<=ub);
  switch(ub-lb){
    case 1:  return COMPONENT::set_param_by_name("$mfactor", Value);
    break; // -1
    case 0: return COMPONENT::set_param_by_name(Name, Value);
  }
  return lb;
  }
}
/*--------------------------------------------------------------------------*/
void MOD_resistor::precalc_first()
{
  BASE_SUBCKT::precalc_first();
  trace2("resistor::pf", long_label(), mfactor());
  auto c = static_cast<COMMON_resistor*>(mutable_common());
  assert(c);
  auto cc = c->clone();
  if(subckt()){
    attach_common(nullptr);
    attach_common(cc);
    subckt()->precalc_first();
  }else{
  }
}
/*--------------------------------------------------------------------------*/
int MOD_resistor::is_valid()const
{
  COMMON_resistor const* c = prechecked_cast<COMMON_resistor const*>(common());
  try{
    return c->is_valid();
  }catch(Exception_OutOfRange_ const& e){
    error(bDEBUG, long_label() + " invalid: " + e.message() + "\n");
    return false;
  }
}
/*--------------------------------------------------------------------------*/
void MOD_resistor::expand()
{
  trace1("expand", long_label());
  BASE_SUBCKT::expand();
  assert(common());
  auto c = static_cast</*const*/ COMMON_resistor*>(mutable_common());
  assert(c);
  (void)c;
  if (!subckt()) {
    new_subckt();
  }else{
  }

  node_t gnd;
  gnd.set_to_ground(nullptr);
  if (_sim->is_first_expand()) {
    for(int i=0; i<ext_nodes()+int_nodes(); ++i){
      trace3("expand0 clear", long_label(), i, n_(i).e_());
    }
    assert(scope());
    assert(scope()->nodes());
    NODE_MAP& nodes = *scope()->nodes();
    (void)nodes;
//port p 1
//port n 2
    for(int i=net_nodes(); i<ext_nodes()+int_nodes(); ++i){
      n_(i).clear();
    }
    for(int i=0; i<ext_nodes()+int_nodes(); ++i){
      trace3("expand2 clear", long_label(), i, n_(i).e_());
    }
  // port p 1
  find_subset(&n_(n_p));
  // port n 2
  find_subset(&n_(n_n));
  // ground
  n_(n_white_noise_0_p).set_to_ground(nullptr);
    precalc_first();

  // clone branches
  // filter (white_noise_0_p)
    {
    if (!_b_white_noise_0_p_) {
      const CARD* p = device_dispatcher["va_white_noise"]; // va_white_noise
      if(!p){
        throw Exception("Cannot find va_white_noise. Load module?");
      }else{
      }
      _b_white_noise_0_p_ = dynamic_cast<ELEMENT*>(p->clone()); // elt
      if(!_b_white_noise_0_p_){
        throw Exception("Cannot use va_white_noise: wrong type");
      }else{
      }
      subckt()->push_front(_b_white_noise_0_p_);
    }else{
    }
      {
        node_t nodes[] = {n_(n_p), n_(n_n)}; // nodes
        _b_white_noise_0_p_->set_parameters("_b_white_noise_0_p_", this, _b_white_noise_0_p_->mutable_common(), 0., /*states:*/2, _st_b_white_noise_0_p_, 2, nodes);
        if(auto e = dynamic_cast<ELEMENT*>(_b_white_noise_0_p_)){
          e->_loss0 = 0.;
          e->_loss1 = 0.;
        }else{
        }
      }
    }
  // branch (p, n)
    {
    if (!_b_p_n) {
      const CARD* p = device_dispatcher["va_flow"]; // va_flow
      if(!p){
        throw Exception("Cannot find va_flow. Load module?");
      }else{
      }
      _b_p_n = dynamic_cast<ELEMENT*>(p->clone()); // elt
      if(!_b_p_n){
        throw Exception("Cannot use va_flow: wrong type");
      }else{
      }
      subckt()->push_front(_b_p_n);
    }else{
    }
      {
        node_t nodes[] = {n_(n_p), n_(n_n)}; // nodes
        _b_p_n->set_parameters("_b_p_n", this, &_C_V_electrical, 0., /*states:*/2, _st_b_p_n, 2, nodes);
      }
    }

  // clone filters

  }else{
      //precalc();
  }
  //precalc();
  subckt()->expand();
  //subckt()->precalc();
  // alloc ground
  trace2("float0?", long_label(), n_(1).e_());
  n_(1).allocate(2); // no-op unless floating
  trace2("float1?", long_label(), n_(1).e_());
  trace2("float0?", long_label(), n_(0).e_());
  n_(0).allocate(2); // no-op unless floating
  trace2("float1?", long_label(), n_(0).e_());
  assert(!is_constant());
  for(CARD_LIST::iterator i=subckt()->begin(); i!=subckt()->end(); ++i){
    CARD* d = (*i)->deflate();
    if(d == (*i)){
    }else{
      assert(d->owner() == this);
      delete *i;
      *i = d;
    }
  }
}
/*--------------------------------------------------------------------------*/
void MOD_resistor::precalc_last()
{
  COMPONENT::precalc_last();
#if __cplusplus >= 202002L
  auto c = prechecked_cast<COMMON_resistor*>(common()->clone());
#else
  auto c = prechecked_cast<COMMON_resistor*>(mutable_common());
#endif
  assert(c);
  (void)c;
  zero_filter_readout();
  c->precalc_analog(this);
  if(subckt()){
    if(HS_PARAM const* h = hsparam()){
      PARAM_LIST const* s = scope()->params();
      h->precalc_hierarchy(s, subckt()->params());
    }else{ untested();
    }
    subckt()->precalc_last();
  }else{untested();
  }
#if __cplusplus >= 202002L
  {itested();
    attach_common(c);
  }
#endif
}
/*--------------------------------------------------------------------------*/
inline MOD_resistor* DEV(COMPONENT* d)
{
  auto m = prechecked_cast<MOD_resistor*>(d);
  assert(m);
  return m;
};
/*--------------------------------------------------------------------------*/
MOD_resistor::ddouble MOD_resistor::_b_white_noise_0(ddouble t0, std::string what)
{
  (void)what;
  MOD_resistor* d = this;
  typedef MOD_resistor MOD;
    d->_st_b_white_noise_0_p_[0] = + t0.value();
  // subdevice
  t0 = 0.;
  trace2("filt", t0, d->_b_white_noise_0_p_->tr_outvolts());
  t0[d_potential_b_white_noise_0_p_] = -1.;
  assert(t0 == t0);
  return t0; // (output)
}
/*--------------------------------------------------------------------------*/
ddouble MOD_resistor::_b_white_noise_0__precalc(ddouble, std::string what) {
  (void)what;
  ddouble ret = 0.;
  COMPONENT* l = _b_white_noise_0_p_;
  assert(l);
  l->set_param_by_name("name", "");
  l->set_param_by_name("name", what);
  ret[d_potential_b_white_noise_0_p_] = -1.;
  return ret;
}
