class array_{
  std::vector<double> _v;
public:
  array_() {}
  array_(double a0) {
    _v.push_back(a0);
  }
  array_(double a0, double a1) {
    _v.push_back(a0);
    _v.push_back(a1);
  }
  template<typename... Args>
  array_(Args... args) {
    push_back(args...);
  }

  size_t size() const{return _v.size();}
  double const& operator[](int x)const {return _v[x];}
private:
  template<typename T>
  void push_back(T t) {
    _v.push_back(t);
  }
  template<typename T, typename... Args>
  void push_back(T t, Args... args) {
    _v.push_back(t);
    push_back(args...);
  }
};
/*--------------------------------------------------------------------------*/
template<class A, class T>
class wrap_arg{
   A _a;
   T& _d;
public:
   wrap_arg(T& d) : _d(d) { _a = d; }
   operator A&() { return _a; }
   ~wrap_arg() { _d = std::move(T(_a)); }
};
/*--------------------------------------------------------------------------*/
template<class S, class T>
wrap_arg<S, T> io_arg(S, T& d) { return wrap_arg<S, T>(d); }
