inline MOD_resistor* DEV(COMPONENT* d)
{
  auto m = prechecked_cast<MOD_resistor*>(d);
  assert(m);
  return m;
};
/*--------------------------------------------------------------------------*/
MOD_resistor::ddouble MOD_resistor::_b_white_noise_1(ddouble t0, std::string what)
{
  (void)what;
  MOD_resistor* d = this;
  typedef MOD_resistor MOD;
    d->_st_b_white_noise_1_p_[0] = + t0.value();
  // subdevice
  t0 = 0.;
  trace2("filt", t0, d->_b_white_noise_1_p_->tr_outvolts());
  t0[d_potential_b_white_noise_1_p_] = -1.;
  assert(t0 == t0);
  return t0; // (output)
}
/*--------------------------------------------------------------------------*/
ddouble MOD_resistor::_b_white_noise_1__precalc(ddouble, std::string what) {
  (void)what;
  ddouble ret = 0.;
  COMPONENT* l = _b_white_noise_1_p_;
  assert(l);
  l->set_param_by_name("name", "");
  l->set_param_by_name("name", what);
  ret[d_potential_b_white_noise_1_p_] = -1.;
  return ret;
}
