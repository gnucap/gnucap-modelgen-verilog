/*--------------------------------------------------------------------------*/
int COMMON_resistor::is_valid() const
{
  COMMON_resistor const* pc = this;
  (void)pc;
  {
  double lb, ub;
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 =  0.; // 
  lb = t0;
  }
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 =  Inf; // 
  ub = t0;
  }
  if(!(lb<=_p_r && _p_r<ub)){
      throw Exception_OutOfRange_("r","from " + to_string(lb) + " .." + to_string(ub));
    }else{
    }
  }
  return true; //COMMON_COMPONENT::is_valid();
}
