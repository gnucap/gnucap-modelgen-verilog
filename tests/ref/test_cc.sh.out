/*--------------------------------------------------------------------------*/
#if __cplusplus >= 202002L
int COMMON_resistor::operator<=>(const COMMON_COMPONENT& x) const
{
  if(this == &x){
    return 0;
  }else{
  }
  std::type_index a(typeid(*this));
  std::type_index b(typeid(x));
  if(a < b){
    return -1;
  }else if(a > b){
    return 1;
  }else{
  }
  int c;
  if((c = COMMON_COMPONENT::compare(x))){
    return c;
  }else{
  }
  auto p = prechecked_cast<const COMMON_resistor*>(&x);
  assert(p);
  if((c = _p_r.compare(p->_p_r))){
    return c;
  }else if((c = _p_tc1.compare(p->_p_tc1))){
    return c;
  }else if((c = _p_tc2.compare(p->_p_tc2))){
    return c;
  }else if((c = _p_noisy.compare(p->_p_noisy))){
    return c;
  }else if((c = _p_tnom.compare(p->_p_tnom))){
    return c;
  }else {
  }
if(double tt = _temp_k - p->_temp_k){
  return tt>0?1:-1;
}
  auto ord = _v_ <=> p->_v_;
  if(ord == std::weak_ordering::equivalent){
    return 0;
  }else if(ord == std::weak_ordering::less){
    return -1;
  }else if(ord == std::weak_ordering::greater){
    return 1;
  }else{untested();
    unreachable()
    return 0;
  }
}
/*--------------------------------------------------------------------------*/
#else
int COMMON_resistor::compare(const COMMON_COMPONENT& x)const
{
  const COMMON_resistor* p = dynamic_cast<const COMMON_resistor*>(&x);
  assert (p);
  if(this == &x){
    return 0;
  }else{
  }
if(double tt = _temp_k - p->_temp_k){
  return tt>0?1:-1;
}
  return 0;
}
/*--------------------------------------------------------------------------*/
bool COMMON_resistor::operator==(const COMMON_COMPONENT& x)const
{
  const COMMON_resistor* p = dynamic_cast<const COMMON_resistor*>(&x);
  return (p
    && _p_r == p->_p_r
    && _p_tc1 == p->_p_tc1
    && _p_tc2 == p->_p_tc2
    && _p_noisy == p->_p_noisy
    && _p_tnom == p->_p_tnom
#if __cplusplus >= 202002L
    && _v_ == p->_v_
#endif
    && !compare(*p)
    && COMMON_COMPONENT::operator==(x));
}
/*--------------------------------------------------------------------------*/
#endif
void COMMON_resistor::set_param_by_index(int I, std::string& Value, int /*Offset*/)
{
  switch (I) {
  case 0:  _p_r = Value; break;
  case 1:  _p_tc1 = Value; break;
  case 2:  _p_tc2 = Value; break;
  case 3:  _p_noisy = Value; break;
  case 4:  _p_tnom = Value; break;
    default: incomplete(); // throw? COMMON_COMPONENT::set_param_by_index(I - 5, Value, Offset + 5);
  }
  (void) Value;
}
/*--------------------------------------------------------------------------*/
int COMMON_resistor::set_param_by_name(std::string Name, std::string Value)
{
  trace2("spbn resistor", Name, Value);
  {
  static std::string names[] = {"m", "noisy", "r", "tc1", "tc2", "tnom"  };
  int lb = 0;
  int ub = 6;
  while(lb < ub) {
    int mid = (lb+ub)/2;
    int c = std::strcmp(Name.c_str(), names[mid].c_str());
    if(c<0){
      ub = mid;
    }else if(c>0){
      lb = mid+1;
    }else{
      lb = mid;
      ub = 6;
      assert(lb<ub);
      break;
    }
  }
  assert(lb<=ub);
  switch(ub-lb){
    case 6:  return COMMON_COMPONENT::set_param_by_name("$mfactor", Value);
    break; // -1
    case 5:_p_noisy = Value;    break; // 0
    case 4:_p_r = Value;    break; // 0
    case 3:_p_tc1 = Value;    break; // 0
    case 2:_p_tc2 = Value;    break; // 0
    case 1:_p_tnom = Value;    break; // 0
    case 0: return COMMON_COMPONENT::set_param_by_name(Name, Value);
  }
  return lb;
  }
}
/*--------------------------------------------------------------------------*/
bool COMMON_resistor::param_is_printable(int I)const
{
  switch (I) {
  case 0:  return (_p_r.has_hard_value());
  case 1:  return (_p_tc1.has_hard_value());
  case 2:  return (_p_tc2.has_hard_value());
  case 3:  return (_p_noisy.has_hard_value());
  case 4:  return (_p_tnom.has_hard_value());
  default: return COMMON_COMPONENT::param_is_printable(I - 5);
  }
}
/*--------------------------------------------------------------------------*/
std::string COMMON_resistor::param_name(int I)const
{
  switch (I) {
  case 0:  return "r";
  case 1:  return "tc1";
  case 2:  return "tc2";
  case 3:  return "noisy";
  case 4:  return "tnom";
  default: return COMMON_COMPONENT::param_name(I - 5);
  }
}
/*--------------------------------------------------------------------------*/
std::string COMMON_resistor::param_name(int I, int j)const
{
  if(j==0){
    return param_name(I);
  }else{
    return "";
  }
}
/*--------------------------------------------------------------------------*/
std::string COMMON_resistor::param_value(int I)const
{
  switch (I) {
  case 0:  return _p_r.string();
  case 1:  return _p_tc1.string();
  case 2:  return _p_tc2.string();
  case 3:  return _p_noisy.string();
  case 4:  return _p_tnom.string();
  default: return COMMON_COMPONENT::param_value(I - 5);
  }
}
/*--------------------------------------------------------------------------*/
int COMMON_resistor::is_valid() const
{
  COMMON_resistor const* pc = this;
  (void)pc;
  {
  double lb, ub;
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 =  0.; // 
  lb = t0;
  }
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 =  Inf; // 
  ub = t0;
  }
  if(!(lb<=_p_r && _p_r<ub)){
      throw Exception_OutOfRange_("r","from " + to_string(lb) + " .." + to_string(ub));
    }else{
    }
  }
  {
  double lb, ub;
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 = 0; // 
  lb = t0;
  }
  {
  ddouble t0;
  //t0.set_no_deps();
  t0 = 1; // 
  ub = t0;
  }
  if(!(lb<=_p_noisy && _p_noisy<=ub)){
      throw Exception_OutOfRange_("noisy","from " + to_string(lb) + " .." + to_string(ub));
    }else{
    }
  }
  return true; //COMMON_COMPONENT::is_valid();
}
