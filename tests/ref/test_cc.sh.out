/*--------------------------------------------------------------------------*/
#if __cplusplus >= 202002L
int COMMON_capacitor::operator<=>(const COMMON_COMPONENT& x) const
{
  if(this == &x){
    return 0;
  }else{
  }
  std::type_index a(typeid(*this));
  std::type_index b(typeid(x));
  if(a < b){
    return -1;
  }else if(a > b){
    return 1;
  }else{
  }
  int c;
  if((c = COMMON_COMPONENT::compare(x))){
    return c;
  }else{
  }
  auto p = prechecked_cast<const COMMON_capacitor*>(&x);
  assert(p);
  if((c = _p_c.compare(p->_p_c))){
    return c;
  }else if(_p___c < p->_p___c) {
    return -1;
  }else if(_p___c > p->_p___c) {
    return 1;
  }else if(_p___ic < p->_p___ic) {
    return -1;
  }else if(_p___ic > p->_p___ic) {
    return 1;
  }else {
  }
  auto ord = _v_ <=> p->_v_;
  if(ord == std::weak_ordering::equivalent){
    return 0;
  }else if(ord == std::weak_ordering::less){
    return -1;
  }else if(ord == std::weak_ordering::greater){
    return 1;
  }else{untested();
    unreachable()
    return 0;
  }
}
/*--------------------------------------------------------------------------*/
#else
int COMMON_capacitor::compare(const COMMON_COMPONENT& x)const
{
  const COMMON_capacitor* p = dynamic_cast<const COMMON_capacitor*>(&x);
  assert (p);
  if(this == &x){
    return 0;
  }else{
  }
  return 0;
}
/*--------------------------------------------------------------------------*/
bool COMMON_capacitor::operator==(const COMMON_COMPONENT& x)const
{
  const COMMON_capacitor* p = dynamic_cast<const COMMON_capacitor*>(&x);
  return (p
    && _p_c == p->_p_c
    && _p___c == p->_p___c
    && _p___ic == p->_p___ic
#if __cplusplus >= 202002L
    && _v_ == p->_v_
#endif
    && !compare(*p)
    && COMMON_COMPONENT::operator==(x));
}
