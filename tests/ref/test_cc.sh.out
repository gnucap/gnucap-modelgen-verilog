inline void MOD_resistor::read_probes()
{
  trace0("resistor::read_probes");
  node_t gnd(&ground_node);
  // filter _b_white_noise_0_p_
  _potential_b_p_n = volts_limited(n_(n_p), n_(n_n));
}
