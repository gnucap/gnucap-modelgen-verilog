inline TIME_PAIR MOD_capacitor::tr_review()
{
  if(_sim->_phase == p_RESTORE) {
    return _time_by;
  }else{
  }
  _time_by = BASE_SUBCKT::tr_review();
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  trace1("review0", _time_by._event);
  c->tr_review_analog(this);
  if(_accept){
    COMPONENT::q_accept();
    trace1("capacitor::_accept", _sim->_time0);
  }else{
  }
  trace3("review done", long_label(), _sim->_time0, _time_by._event);
  return _time_by;
}
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::tr_accept()
{
  if(_sim->_phase == p_RESTORE) {
    return;
  }else{
  }
  assert(_sim->_phase != p_RESTORE);
  trace1("capacitor::tr_accept", _sim->_time0);
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  c->tr_accept_analog(this);
  return BASE_SUBCKT::tr_accept();
} // tr_accept
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::tr_advance()
{
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  (void)c;
  if(_sim->_phase == p_RESTORE) {untested();
    return;
  }else{
  }
  _accept = 0;
  if(_sim->_last_time == 0.){
  incomplete();
  c->tr_eval_analog(this);
  }else{
  }
  set_not_converged();
  _v_1 = _v_;
  c->tr_advance_analog(this);
  BASE_SUBCKT::tr_advance();
} // tr_advance
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::tr_regress()
{
  BASE_SUBCKT::tr_regress();
  set_not_converged();
  q_eval();
  if(_sim->_phase == p_RESTORE) {
    return;
  }else{
  }
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  c->tr_regress_analog(this);
}
/*--------------------------------------------------------------------------*/
  std::string MOD_capacitor::port_name(int i)const
{
    assert(i >= 0);
    assert(i < max_nodes());
    static std::string names[] = {"p", "n"    };
    return names[i];
  }
/*--------------------------------------------------------------------------*/
MOD_capacitor m_capacitor;
DISPATCHER<CARD>::INSTALL d0(&device_dispatcher, "capacitor", &m_capacitor);
/*--------------------------------------------------------------------------*/
CARD* MOD_capacitor::clone()const
{
  MOD_capacitor* new_instance = new MOD_capacitor(*this);
  assert(!new_instance->subckt());
  return new_instance;
}
/*--------------------------------------------------------------------------*/
MOD_capacitor::MOD_capacitor(MOD_capacitor const&p) : BASE_SUBCKT(p)
{
  for (int ii = 0; ii < max_nodes(); ++ii) {
    n_(ii) = p.n_(ii);
    }
}
/*--------------------------------------------------------------------------*/
void MOD_capacitor::precalc_first()
{
  BASE_SUBCKT::precalc_first();
  trace2("capacitor::pf", long_label(), mfactor());
  auto c = static_cast<COMMON_capacitor*>(mutable_common());
  assert(c);
  auto cc = c->clone();
  if(subckt()){
    attach_common(nullptr);
    attach_common(cc);
    subckt()->precalc_first();
  }else{
  }
}
/*--------------------------------------------------------------------------*/
int MOD_capacitor::is_valid()const
{
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  try{
    return c->is_valid();
  }catch(Exception_OutOfRange_ const& e){
    error(bDEBUG, long_label() + " invalid: " + e.message() + "\n");
    return false;
  }
}
/*--------------------------------------------------------------------------*/
void MOD_capacitor::expand()
{
  trace1("expand", long_label());
  BASE_SUBCKT::expand();
  assert(common());
  auto c = static_cast</*const*/ COMMON_capacitor*>(mutable_common());
  assert(c);
  (void)c;
  if (!subckt()) {
    new_subckt();
  }else{
  }

  node_t gnd;
  gnd.set_to_ground(nullptr);
  if (_sim->is_first_expand()) {
    for(int i=0; i<ext_nodes()+int_nodes(); ++i){
      trace3("expand0 clear", long_label(), i, n_(i).e_());
    }
    assert(scope());
    assert(scope()->nodes());
    NODE_MAP& nodes = *scope()->nodes();
    (void)nodes;
//port p 1
//port n 2
    for(int i=net_nodes(); i<ext_nodes()+int_nodes(); ++i){
      n_(i).clear();
    }
    for(int i=0; i<ext_nodes()+int_nodes(); ++i){
      trace3("expand2 clear", long_label(), i, n_(i).e_());
    }
  // port p 1
  find_subset(&n_(n_p));
  // port n 2
  find_subset(&n_(n_n));
  // ground
  n_(n_ddt_1_p).set_to_ground(nullptr);
    precalc_first();

  // clone branches
  // filter (ddt_1_p)
    {
    if (!_b_ddt_1_p_) {
      const CARD* p = device_dispatcher["va_ddt"]; // va_ddt
      if(!p){
        throw Exception("Cannot find va_ddt. Load module?");
      }else{
      }
      _b_ddt_1_p_ = dynamic_cast<ELEMENT*>(p->clone()); // elt
      if(!_b_ddt_1_p_){
        throw Exception("Cannot use va_ddt: wrong type");
      }else{
      }
      subckt()->push_front(_b_ddt_1_p_);
    }else{
    }
      {
        node_t nodes[] = {n_(n_p), n_(n_n), n_(n_p), n_(n_n)}; // nodes
        _b_ddt_1_p_->set_parameters("_b_ddt_1_p_", this, _b_ddt_1_p_->mutable_common(), 0., /*states:*/3, _st_b_ddt_1_p_, 4, nodes);
        if(auto e = dynamic_cast<ELEMENT*>(_b_ddt_1_p_)){
          e->_loss0 = 0.;
          e->_loss1 = 0.;
        }else{
        }
      }
    }
  // branch (p, n)
    {
    if (!_b_p_n) {
      const CARD* p = device_dispatcher["va_flow"]; // va_flow
      if(!p){
        throw Exception("Cannot find va_flow. Load module?");
      }else{
      }
      _b_p_n = dynamic_cast<ELEMENT*>(p->clone()); // elt
      if(!_b_p_n){
        throw Exception("Cannot use va_flow: wrong type");
      }else{
      }
      subckt()->push_front(_b_p_n);
    }else{
    }
      {
        node_t nodes[] = {n_(n_p), n_(n_n)}; // nodes
        _b_p_n->set_parameters("_b_p_n", this, &_C_V_electrical, 0., /*states:*/2, _st_b_p_n, 2, nodes);
      }
    }

  // clone filters

  }else{
      //precalc();
  }
  //precalc();
  subckt()->expand();
  //subckt()->precalc();
  // alloc ground
  trace2("float0?", long_label(), n_(1).e_());
  n_(1).allocate(2); // no-op unless floating
  trace2("float1?", long_label(), n_(1).e_());
  trace2("float0?", long_label(), n_(0).e_());
  n_(0).allocate(2); // no-op unless floating
  trace2("float1?", long_label(), n_(0).e_());
  assert(!is_constant());
  for(CARD_LIST::iterator i=subckt()->begin(); i!=subckt()->end(); ++i){
    CARD* d = (*i)->deflate();
    if(d == (*i)){
    }else{
      assert(d->owner() == this);
      delete *i;
      *i = d;
    }
  }
}
/*--------------------------------------------------------------------------*/
void MOD_capacitor::precalc_last()
{
  COMPONENT::precalc_last();
#if __cplusplus >= 202002L
  auto c = prechecked_cast<COMMON_capacitor*>(common()->clone());
#else
  auto c = prechecked_cast<COMMON_capacitor*>(mutable_common());
#endif
  assert(c);
  (void)c;
  zero_filter_readout();
  c->precalc_analog(this);
  if(subckt()){
    if(HS_PARAM const* h = hsparam()){
      PARAM_LIST const* s = scope()->params();
      h->precalc_hierarchy(s, subckt()->params());
    }else{ untested();
    }
    subckt()->precalc_last();
  }else{untested();
  }
#if __cplusplus >= 202002L
  {itested();
    attach_common(c);
  }
#endif
}
/*--------------------------------------------------------------------------*/
inline MOD_capacitor* DEV(COMPONENT* d)
{
  auto m = prechecked_cast<MOD_capacitor*>(d);
  assert(m);
  return m;
};
/*--------------------------------------------------------------------------*/
//cc impl
MOD_capacitor::ddouble MOD_capacitor::_b_ddt_1(ddouble t0)
{
  MOD_capacitor* d = this;
  typedef MOD_capacitor MOD;
  d->_st_b_ddt_1_p_[0] = + t0.value();
  // dep _potential_b_p_n
  assert(t0[d_potential_b_p_n] == t0[d_potential_b_p_n]);
  // assert(!d->_st_b_ddt_1_p_[2]);
  d->_st_b_ddt_1_p_[MOD::_st_b_ddt_1_p__::dep_potential_b_p_n]  = + t0[d_potential_b_p_n]; // (4)
  // subdevice
  t0 = 0.;
  assert(t0 == t0);
  return t0;
}
