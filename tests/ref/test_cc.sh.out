{
//OUT_ANALOG precalc
  MOD_capacitor const* p = m;
  MOD_capacitor* d = m;
  (void)p;
  assert(p);
  COMMON_capacitor const* pc = this;
  (void)pc;
  (void)d;
  { // AnalogConstruct
// construct block...
    { // anonymous block
      {
        double f0;
        { // scope
          // F analysis args:1
          std::string s0;
          s0 = "ic";
          // --- 
          f0 = _f_analysis(s0); // (659)
        } // scope
        ddouble t0;
        //t0.set_no_deps();
        t0 =  1. && f0; // (703)
        if (t0) {
          { // anonymous block
            { // Contribution V(p, n) lin: 1
              ddouble t0;
              //t0.set_no_deps();
              t0 = (_p___ic) /*rhspar*/; // precalc
              //noddeps..
            }
          }
        }else {
          { // anonymous block
            { // Contribution I(p, n) lin: 1
              ddouble t0;
              //t0.set_no_deps();
              //t0[d_potential_b_ddt_2_p_] = 0.; // (output dep)
              { // scope
                // F ddt args:1
                ddouble t1;
                //t1.set_no_deps();
                //t1[d_potential_b_ddt_2_p_] = 0.; // (output dep)
                t1.set_no_deps();
                t1 = 0.; // precalc.
                t1 = (_p___c) /*rhspar*/ * t1; // (703)
                // --- 
                t0 = /*precalc*/ d->_b_ddt_2precalc(t1); // (659)
              } // scope
              m->_st_b_ddt_2_p_[1] = +1; // (3q)
            }
          }
        }

      }
    }
  }
}
