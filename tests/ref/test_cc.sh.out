MOD_resistor::MOD_resistor()
    :BASE_SUBCKT()
{
  attach_common(&Default_resistor());
  set_owner(nullptr);
  // build netlist
  // ports:2
  // overrides
}
/*--------------------------------------------------------------------------*/
// seq blocks
/*--------------------------------------------------------------------------*/
bool MOD_resistor::tr_needs_eval()const
{
  trace3("resistor::needs_eval?", long_label(), _sim->_time0, has_probes());
  node_t gnd(&ground_node);
  if (is_q_for_eval()) {
    trace3("resistor::needs_eval?", long_label(), _sim->_time0, is_q_for_eval());
    return false;
  }else if (!converged()) {
    return true;
  }else if (has_probes()) {
    return true;
  }else   if(_sim->is_first_iteration()){
    return true;
  }else if( !conchk(_potential_b_p_n, n_(n_p).v0() - n_(n_n).v0(), 1e-6)){
    return true;
  }else{
    return false;
  }
};
