    // same1 _potential_b_p_n
    trace2("_st_b_p_nself", _st_b_p_n[1], _potential_b_p_n);
    // generic: 0
    // self
    _st_b_p_n[0] -= _st_b_p_n[1] * _potential_b_p_n; // (4)
    // sources...
      { // set state 
      long double sp = 0.;
