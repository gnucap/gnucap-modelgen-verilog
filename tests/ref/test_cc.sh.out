MOD_capacitor::MOD_capacitor(MOD_capacitor const&p) : BASE_SUBCKT(p)
{
  for (int ii = 0; ii < max_nodes(); ++ii) {
    n_(ii) = p.n_(ii);
    }
}
/*--------------------------------------------------------------------------*/
void MOD_capacitor::precalc_first()
{
  BASE_SUBCKT::precalc_first();
  trace2("capacitor::pf", long_label(), mfactor());
  auto c = static_cast<COMMON_capacitor*>(mutable_common());
  assert(c);
  auto cc = c->clone();
  if(subckt()){
    attach_common(nullptr);
    attach_common(cc);
    subckt()->precalc_first();
  }else{
  }
}
/*--------------------------------------------------------------------------*/
int MOD_capacitor::is_valid()const
{
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  try{
    return c->is_valid();
  }catch(Exception_OutOfRange_ const& e){
    error(bDEBUG, long_label() + " invalid: " + e.message() + "\n");
    return false;
  }
}
/*--------------------------------------------------------------------------*/
void MOD_capacitor::expand()
{
  trace1("expand", long_label());
  BASE_SUBCKT::expand();
  assert(common());
  auto c = static_cast</*const*/ COMMON_capacitor*>(mutable_common());
  assert(c);
  (void)c;
  if (!subckt()) {
    new_subckt();
  }else{
  }

  node_t gnd;
  gnd.set_to_ground(nullptr);
  if (_sim->is_first_expand()) {
    for(int i=0; i<ext_nodes()+int_nodes(); ++i){
      trace3("expand0 clear", long_label(), i, n_(i).e_());
    }
    assert(scope());
    assert(scope()->nodes());
    NODE_MAP& nodes = *scope()->nodes();
    (void)nodes;
//port p 1
//port n 2
    for(int i=net_nodes(); i<ext_nodes()+int_nodes(); ++i){
      n_(i).clear();
    }
    for(int i=0; i<ext_nodes()+int_nodes(); ++i){
      trace3("expand2 clear", long_label(), i, n_(i).e_());
    }
  // port p 1
  find_subset(&n_(n_p));
  // port n 2
  find_subset(&n_(n_n));
  // internal ddt_2_p : 3
  // node ddt_2_p 3
    if (_short_b_ddt_2()) {
      n_(n_ddt_2_p) = gnd;
    }else{
      n_(n_ddt_2_p).new_model_node("." + long_label() + ".ddt_2_p", this);
    }
    precalc_first();

  // clone branches
  // filter (ddt_2_p)
    {
    if (!_b_ddt_2_p_) {
      const CARD* p = device_dispatcher["va_ddt"]; // va_ddt
      if(!p){
        throw Exception("Cannot find va_ddt. Load module?");
      }else{
      }
      _b_ddt_2_p_ = dynamic_cast<ELEMENT*>(p->clone()); // elt
      if(!_b_ddt_2_p_){
        throw Exception("Cannot use va_ddt: wrong type");
      }else{
      }
      subckt()->push_front(_b_ddt_2_p_);
    }else{
    }
      {
        node_t nodes[] = {n_(n_ddt_2_p), gnd, n_(n_p), n_(n_n)}; // nodes
        _b_ddt_2_p_->set_parameters("_b_ddt_2_p_", this, _b_ddt_2_p_->mutable_common(), 0., /*states:*/3, _st_b_ddt_2_p_, 4, nodes);
      }
    }
  // branch (p, n)
    {
    if (!_b_p_n) {
      const CARD* p = device_dispatcher["va_sw"]; // va_sw
      if(!p){
        throw Exception("Cannot find va_sw. Load module?");
      }else{
      }
      _b_p_n = dynamic_cast<ELEMENT*>(p->clone()); // elt
      if(!_b_p_n){
        throw Exception("Cannot use va_sw: wrong type");
      }else{
      }
      subckt()->push_front(_b_p_n);
    }else{
    }
      {
        node_t nodes[] = {n_(n_p), n_(n_n), n_(n_ddt_2_p), gnd}; // nodes
        _b_p_n->set_parameters("_b_p_n", this, &_C_V_electrical, 0., /*states:*/3, _st_b_p_n, 4, nodes);
      }
    }

  // clone filters

  }else{
      //precalc();
  }
  //precalc();
  subckt()->expand();
  //subckt()->precalc();
  n_(2).allocate(2);
  trace2("float0?", long_label(), n_(1).e_());
  n_(1).allocate(2); // no-op unless floating
  trace2("float1?", long_label(), n_(1).e_());
  trace2("float0?", long_label(), n_(0).e_());
  n_(0).allocate(2); // no-op unless floating
  trace2("float1?", long_label(), n_(0).e_());
  assert(!is_constant());
  for(CARD_LIST::iterator i=subckt()->begin(); i!=subckt()->end(); ++i){
    CARD* d = (*i)->deflate();
    if(d == (*i)){
    }else{
      assert(d->owner() == this);
      delete *i;
      *i = d;
    }
  }
}
/*--------------------------------------------------------------------------*/
void MOD_capacitor::precalc_last()
{
  COMPONENT::precalc_last();
#if __cplusplus >= 202002L
  auto c = prechecked_cast<COMMON_capacitor*>(common()->clone());
#else
  auto c = prechecked_cast<COMMON_capacitor*>(mutable_common());
#endif
  assert(c);
  (void)c;
  zero_filter_readout();
  c->precalc_analog(this);
  if(subckt()){
    if(HS_PARAM const* h = hsparam()){
      PARAM_LIST const* s = scope()->params();
      h->precalc_hierarchy(s, subckt()->params());
    }else{ untested();
    }
    subckt()->precalc_last();
  }else{untested();
  }
#if __cplusplus >= 202002L
  {itested();
    attach_common(c);
  }
#endif
}
