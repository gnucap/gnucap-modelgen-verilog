#endif
void COMMON_capacitor::set_param_by_index(int I, std::string& Value, int /*Offset*/)
{
  switch (I) {
  case 0:  _p_c = Value; break;
    default: incomplete(); // throw? COMMON_COMPONENT::set_param_by_index(I - 1, Value, Offset + 1);
  }
  (void) Value;
}
/*--------------------------------------------------------------------------*/
int COMMON_capacitor::set_param_by_name(std::string Name, std::string Value)
{
  trace2("spbn capacitor", Name, Value);
  {
  static std::string names[] = {"c"  };
  int lb = 0;
  int ub = 1;
  while(lb < ub) {
    int mid = (lb+ub)/2;
    int c = std::strcmp(Name.c_str(), names[mid].c_str());
    if(c<0){
      ub = mid;
    }else if(c>0){
      lb = mid+1;
    }else{
      lb = mid;
      ub = 1;
      assert(lb<ub);
      break;
    }
  }
  assert(lb<=ub);
  switch(ub-lb){
    case 1:_p_c = Value;    break; // 0
    case 0: return COMMON_COMPONENT::set_param_by_name(Name, Value);
  }
  return lb;
  }
}
