/*--------------------------------------------------------------------------*/
inline TIME_PAIR MOD_capacitor::tr_review()
{
  if(_sim->_phase == p_RESTORE) {
    return _time_by;
  }else{
  }
  _time_by = BASE_SUBCKT::tr_review();
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  trace1("review0", _time_by._event);
  c->tr_review_analog(this);
  if(_accept){
    COMPONENT::q_accept();
    trace1("capacitor::_accept", _sim->_time0);
  }else{
  }
  trace3("review done", long_label(), _sim->_time0, _time_by._event);
  return _time_by;
}
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::tr_accept()
{
  if(_sim->_phase == p_RESTORE) {
    return;
  }else{
  }
  assert(_sim->_phase != p_RESTORE);
  trace1("capacitor::tr_accept", _sim->_time0);
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  c->tr_accept_analog(this);
  return BASE_SUBCKT::tr_accept();
} // tr_accept
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::tr_advance()
{
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  (void)c;
  if(_sim->_phase == p_RESTORE) {untested();
    return;
  }else{
  }
  _accept = 0;
  if(_sim->_last_time == 0.){
  incomplete();
  c->tr_eval_analog(this);
  }else{
  }
  set_not_converged();
  _v_1 = _v_;
  c->tr_advance_analog(this);
  BASE_SUBCKT::tr_advance();
} // tr_advance
/*--------------------------------------------------------------------------*/
inline void MOD_capacitor::tr_regress()
{
  BASE_SUBCKT::tr_regress();
  set_not_converged();
  q_eval();
  if(_sim->_phase == p_RESTORE) {
    return;
  }else{
  }
  COMMON_capacitor const* c = prechecked_cast<COMMON_capacitor const*>(common());
  assert(c);
  c->tr_regress_analog(this);
}
