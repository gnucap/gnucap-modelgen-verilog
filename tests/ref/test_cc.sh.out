/*--------------------------------------------------------------------------*/
void COMMON_resistor::precalc_first(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_COMPONENT::precalc_first(par_scope);
  COMMON_resistor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_r),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_tc1),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_tc2),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_noisy),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_tnom),     def , par_scope);
  }
}
/*--------------------------------------------------------------------------*/
void COMMON_resistor::precalc_last(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_resistor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_r),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_tc1),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_tc2),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_noisy),     def , par_scope);
  }
  { // final adjust
    ddouble t0;
    t0 =  0.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_tnom),     def , par_scope);
  }
_temp_k = temp_k(par_scope);
  COMMON_COMPONENT::precalc_last(par_scope);
}
