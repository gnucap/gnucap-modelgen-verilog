double MOD_resistor::tr_probe_num(std::string const& n) const
{
  //i:i
  if(n == "i"){
    return _v_._i;
  }
  if(n == "conv") {
    return converged();
  }
  return BASE_SUBCKT::tr_probe_num(n);
}
