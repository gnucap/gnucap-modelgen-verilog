/*--------------------------------------------------------------------------*/
void COMMON_capacitor::precalc_first(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_COMPONENT::precalc_first(par_scope);
  COMMON_capacitor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_c),     def , par_scope);
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_c) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___c = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 = 0; // adjust
    real def = real(t0.value());
    this->_p___ic = def;
  }
}
/*--------------------------------------------------------------------------*/
void COMMON_capacitor::precalc_last(const PARAM_LIST* par_scope)
{
  assert(par_scope);
  COMMON_capacitor const* pc = this;
  (void)pc;
  { // final adjust
    ddouble t0;
    t0 =  1.; // adjust
    real def = real(t0.value());
    e_val(&(this->_p_c),     def , par_scope);
  }
  { // final adjust localparam
    ddouble t0;
    t0 = (_p_c) /*rhspar*/; // adjust
    real def = real(t0.value());
    this->_p___c = def;
  }
  { // final adjust localparam
    ddouble t0;
    t0 = 0; // adjust
    real def = real(t0.value());
    this->_p___ic = def;
  }
  COMMON_COMPONENT::precalc_last(par_scope);
}
