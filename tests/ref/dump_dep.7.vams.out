module dep7(d, g);
  inout d, g;
  electrical d, g;
  parameter real p =  0.0;

  real T//
;

  analog begin : main // always
    // T : 0
    // c : 0
    real c// *
;
    @(initial_step) begin // e
      if ((! $param_given(p))) begin // e
        // c : 0
        c =  1.0; // s1 r4{abx}
      end
    end
    T = c; // s3 r3{abx}
    I(d, g) <+ c; // s2 r2{x}
  end

endmodule



