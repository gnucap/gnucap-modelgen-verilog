// paramsets
module d1(a, b);
  inout a, b;
  electrical a, b;
  parameter real p =  1.0;
  localparam real __p = p;
  localparam real __P = 0;

  analog begin
    if ( 1.0) begin
      V(a, b) <+ __p;
    end
    if ( 0.0) begin
      V(a, b) <+ 0;
    end
  end

endmodule
module d2(a, b);
  inout a, b;
  electrical a, b;
  parameter real P =  1.0;
  localparam real __p = P;
  localparam real __P = 0;

  analog begin
    if ( 1.0) begin
      V(a, b) <+ __p;
    end
    if ( 0.0) begin
      V(a, b) <+ 0;
    end
  end

endmodule
module d2a(a, b);
  inout a, b;
  electrical a, b;
  parameter real P =  1.0;
  localparam real __P = P;
  localparam real __p = 0;

  analog begin
    if ( 0.0) begin
      V(a, b) <+ 0;
    end
    if ( 1.0) begin
      V(a, b) <+ __P;
    end
  end

endmodule
module d3(a, b);
  inout a, b;
  electrical a, b;
  localparam real __p = 1;
  localparam real __P = 0;

  analog begin
    if ( 1.0) begin
      V(a, b) <+ 1;
    end
    if ( 0.0) begin
      V(a, b) <+ 0;
    end
  end

endmodule
module d4(a, b);
  inout a, b;
  electrical a, b;
  localparam real __p = 0;
  localparam real __P = 0;

  analog begin
    if ( 0.0) begin
      V(a, b) <+ 0;
    end
    if ( 0.0) begin
      V(a, b) <+ 0;
    end
  end

endmodule

