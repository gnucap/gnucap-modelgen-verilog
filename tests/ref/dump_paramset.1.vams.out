module resistor(a, b);
  electrical a, b;
  parameter real r =  1.0 from (0: inf);

  analog begin
    I(a, b) <+ (V(a, b) / r);
  end

endmodule



// paramsets
paramset my_res resistor;
  parameter real R =  1.0;

  .r = R
endparamset;
paramset my_res resistor;
  parameter real R0 =  1.0;
  parameter real R1 =  1.0;

  .r = (R0 + R1)
endparamset;

