module test(d, g, s, b);
  electrical d, g;
  parameter real P = 3;

  real T// +
, U// *
;

  analog begin // always
    // T : 0
    // U : 0
    T = 2; // s1 r3{abx}
    T =  0.0; // s1 r3{abx}
    T = ( 0.0 / P); // s1 r3{abx}
    T = ( 0.0 / U); // s3 r3{abx}
    T = 0; // s1 r3{abx}
    T = 0; // s1 r3{abx}
    T =  2.71828182845905; // s1 r3{abx}
    T =  2.71828182845905; // s1 r3{abx}
    T = pow((U +  20.0855369231877), (T + 2)); // s4 r3{abx}
    T = (exp(U) +  43.0); // s3 r3{abx}
    T = exp(U); // s3 r3{abx}
    T = exp(U); // s3 r3{abx}
    T = (exp(U) *  84.0); // s3 r3{abx}
    T = (exp(U) *  0.5); // s3 r3{abx}
    T = ((exp(U) / 2) /  4.0); // s3 r3{abx}
    U = (U *  0.5); // s2 r3{abx}
    T = (exp(U) *  0.5); // s3 r3{abx}
    T = ( 8.0 / exp(U)); // s3 r3{abx}
    T = ( 0.5 / exp(U)); // s3 r3{abx}
    T = ((2 - exp(U)) -  42.0); // s3 r3{abx}
    T = ( 44.0 - exp(U)); // s3 r3{abx}
    T = (2 - exp(U)); // s3 r3{abx}
    T = (2 - exp(U)); // s3 r3{abx}
    T = (exp(U) -  42.0); // s3 r3{abx}
    T = (exp(U) + -40.0); // s3 r3{abx}
    T = (U *  1.2); // s3 r3{abx}
    T = (P *  1.2); // s1 r3{abx}
    T = ((U *  1.2) * ln((( 400.0e-9 / T) +  1.0))); // s4 r3{abx}
    T = ((P *  1.2) * ln((( 400.0e-9 / T) +  1.0))); // s5 r3{abx}
    T = 0; // s1 r3{abx}
    T =  0.0; // s1 r3{abx}
    T =  0.0; // s1 r3{abx}
  end

endmodule



