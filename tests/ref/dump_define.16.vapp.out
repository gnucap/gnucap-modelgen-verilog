


                    if (BSIM4geoMod < 9)         stuff     T0 = DMCGeff + DMCIeff;    T1 = DMCGeff + DMCGeff;    T2 = DMDGeff + DMDGeff;    PSiso = T0 + T0 + BSIM4weffCJ;    PDiso = PSiso;    PSsha = T1;    PDsha = T1;    PSmer = T2;    PDmer = T2;    ASiso = T0 * BSIM4weffCJ;    ADiso = ASiso;    ASsha = DMCGeff * BSIM4weffCJ;    ADsha = ASsha;    ASmer = DMDGeff * BSIM4weffCJ;    ADmer = ASmer;    case(BSIM4geoMod)    0: begin        BSIM4Pseff = nuEndS * PSiso + nuIntS * PSsha;        dumPd = nuEndD * PDiso + nuIntD * PDsha;        dumAs = nuEndS * ASiso + nuIntS * ASsha;        dumAd = nuEndD * ADiso + nuIntD * ADsha;    end     1: begin         BSIM4Pseff = nuEndS * PSiso + nuIntS * PSsha;        dumPd = (nuEndD + nuIntD) * PDsha;        dumAs = nuEndS * ASiso + nuIntS * ASsha;        dumAd = (nuEndD + nuIntD) * ADsha;    end     2: begin         BSIM4Pseff = (nuEndS + nuIntS) * PSsha;        dumPd = nuEndD * PDiso + nuIntD * PDsha;        dumAs = (nuEndS + nuIntS) * ASsha;        dumAd = nuEndD * ADiso + nuIntD * ADsha;    end     3: begin         BSIM4Pseff = (nuEndS + nuIntS) * PSsha;        dumPd = (nuEndD + nuIntD) * PDsha;        dumAs = (nuEndS + nuIntS) * ASsha;        dumAd = (nuEndD + nuIntD) * ADsha;    end     4: begin         BSIM4Pseff = nuEndS * PSiso + nuIntS * PSsha;        dumPd = nuEndD * PDmer + nuIntD * PDsha;        dumAs = nuEndS * ASiso + nuIntS * ASsha;        dumAd = nuEndD * ADmer + nuIntD * ADsha;    end     5: begin         BSIM4Pseff = (nuEndS + nuIntS) * PSsha;        dumPd = nuEndD * PDmer + nuIntD * PDsha;        dumAs = (nuEndS + nuIntS) * ASsha;        dumAd = nuEndD * ADmer + nuIntD * ADsha;    end    6: begin         BSIM4Pseff = nuEndS * PSmer + nuIntS * PSsha;        dumPd = nuEndD * PDiso + nuIntD * PDsha;        dumAs = nuEndS * ASmer + nuIntS * ASsha;        dumAd = nuEndD * ADiso + nuIntD * ADsha;    end     7: begin         BSIM4Pseff = nuEndS * PSmer + nuIntS * PSsha;        dumPd = (nuEndD + nuIntD) * PDsha;        dumAs = nuEndS * ASmer + nuIntS * ASsha;        dumAd = (nuEndD + nuIntD) * ADsha;    end     8: begin         BSIM4Pseff = nuEndS * PSmer + nuIntS * PSsha;        dumPd = nuEndD * PDmer + nuIntD * PDsha;        dumAs = nuEndS * ASmer + nuIntS * ASsha;        dumAd = nuEndD * ADmer + nuIntD * ADsha;    end     9: begin         BSIM4Pseff = PSiso + (BSIM4nf - 1.0) * PSsha;        dumPd = BSIM4nf * PDsha;        dumAs = ASiso + (BSIM4nf - 1.0) * ASsha;        dumAd = BSIM4nf * ADsha;    end     10: begin        BSIM4Pseff = BSIM4nf * PSsha;        dumPd = PDiso + (BSIM4nf - 1.0) * PDsha;        dumAs = BSIM4nf * ASsha;        dumAd = ADiso + (BSIM4nf - 1.0) * ADsha;    end     default:          $strobe("Warning: (instance X*) Specified GEO=%d not matched (BSIM4PAeffGeo)", BSIM4geoMod);     endcase 
