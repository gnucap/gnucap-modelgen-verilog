// test how deps play with control structures
test_ddx2 #() dut (\1 , \1 , \1 , \0 );
parameter v=0
vsource #(.dc(v)) v1 (\1 , \0 );
#           v(1)       zero(dut)  minus(dut) plus(dut)  iter(0)   
 0.         0.         0.        -1.         1.         2.        
Gnucap   System status
iterations: op=0, dc=2, tran=0, fourier=0, total=2
transient timesteps: accepted=0, rejected=0, total=0
nodes: user=1, subckt=0, model=0, total=1
dctran density=100.0%, ac density=100.0%
