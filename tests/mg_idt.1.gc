attach ./modelgen_0.so
attach ../vams/vsine.so

verilog
options numdgt 20

`modelgen
module test_idt1(p, n, cp, cn);
	electrical p, n, cp, cn;
	analog begin
		I(p,n) <+ idt(V(cp, cn));
	end
endmodule

!make test_idt1.so > /dev/null
attach ./test_idt1.so

verilog
parameter r=1
parameter v=0
parameter pi=3.1415926535897932384626433832795028841972

test_idt1 #() dut(\0 ,\3 ,\1 ,\0 );
vsine #(.freq(1 /6.28), .dc(v), .ampl(1 )) v1 (\1 , \0 );
resistor #(1) r(\0 ,\3 )

list

print tran v nodes idt1(dut) idt2(dut)
print tran + iter(0)
tran 0 {2*pi} {.2*pi} trace=n
options noincmode nobypass
tran 0 {2*pi} {.2*pi} trace=n
status notime
end
