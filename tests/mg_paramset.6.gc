attach ./modelgen_1.so
verilog

`modelgen
module base(p, n);
  electrical p, n;
  parameter real r=1;
  parameter real scale=3.0;
  localparam real R = r * scale;
  analog I(p,n) <+ V(p,n)/R;
endmodule
paramset test_ps6 base
  parameter real rr = 2.;
  .r = rr;
endparamset
`endmodelgen

!make test_ps6.so > /dev/null

attach ./test_ps6.so

verilog

module bla();
// must be localparam...?
	parameter real rr=1;
endmodule;

bla #() bla1();

test_ps6 #() r(\1 , \0 );
isource #(.dc(5)) i(\0 , \1 );

print dc v(nodes) iter(0)
dc

delete bla1
module bla1();
  localparam real rr=2;
endmodule
print dc v(nodes) iter(0)
dc
status notime
