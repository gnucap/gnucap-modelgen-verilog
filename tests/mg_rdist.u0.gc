
attach ./modelgen_0.so
attach vams/resistor.so

verilog

`modelgen test_rdist_u0
module test_rdist_u0(p, n);
	electrical p, n;
	inout p, n;
	(*desc="s"*) integer s;
	(*desc="random1"*) real r1;
	analog begin
		$bound_step(.1);
      r1 = $rdist_uniform(s, 1., 2.);
		I(p,n) <+ r1;
	end
endmodule

list

!make test_rdist_u0.so > /dev/null
attach ./test_rdist_u0.so

ground gnd;

resistor #(.r(1.)) r(gnd, n1);
test_rdist_u0 #() dut1(gnd, n1);

resistor #(.r(1.)) r(gnd, n2);
test_rdist_u0 #() dut1(gnd, n2);

print dc v(nodes) s(dut1) r1(dut1) r2(dut1)
print tran v(nodes) s(dut1) r1(dut1) r2(dut1)

parameter real swp=0;
dc swp 1 3 1
tran 1

status notime
end
