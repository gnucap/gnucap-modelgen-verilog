
load ./modelgen_1.so
load vams/vpulse.so

`modelgen test_mybuf0
module test_mybuf0
endmodule

primitive mybuf0 (out, in1);
output out;
input in1;
table
        0 : 0;
        1 : 1;
endtable
endprimitive
`endmodelgen

!make test_mybuf0.so >/dev/null
attach ./test_mybuf0.so

module test(a, b);
  ground \0 ;
  vpulse #(.val0(0) .val1(5) .width(.2) .period(.5)) v1(b, \0 );
  mybuf0 b(.out(a), .in1(b));
endmodule

spice
.model logic logic
.verilog

test #() t(a, b)
c_d_a #(.model("logic")) cy(a_, a);

list

print op v(a)  v(b)
op

print tran v(a_)  v(b)  l(a)  l(b)
tran 1 trace n
status notime
