
attach ./modelgen_0.so

verilog

`modelgen test_noise1
module test_noise1(p, n);
	electrical p, n;
	inout p, n;
	analog begin
		I(p,n) <+ flicker_noise(0 );
		I(p,n) <+ flicker_noise(1.,1.);
		I(p,n) <+ flicker_noise(1.,1.,"switch");
		I(p,n) <+ V(p,n);
	end
endmodule

list

!make test_noise1.so > /dev/null
attach ./test_noise1.so

test_noise1  #() dut(\1 , \0 );
noise_probe n1(\1 )
noise_probe n2(\1 ,\0  )

list

print ac n(dut.*) npwr(n1)

dc
ac 10 1000 * 10
status notime
end
