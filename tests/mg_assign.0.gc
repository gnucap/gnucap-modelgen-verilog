attach ./modelgen_2.so
attach vams/resistor.so
attach vams/vpulse.so
load logic

options nopicky

`modelgen test_assign0
discipline ldisc;
  domain discrete;
enddiscipline;
module test_assign0(in, a, b);
  parameter integer zero = 0;
  input in;
  output a;
  output b;
  reg b;
  electrical foo;
  ldisc a;
  assign a = !in;
  assign #(zero + 100) b = !in;
endmodule
`endmodelgen

verilog

!make test_assign0.so >/dev/null
load ./test_assign0.so

module test(a, b, c);
  ground \0 ;
  vpulse #(.val0(0) .val1(5) .width(.2u) .period(.5u)) v1(c, \0 );
  test_assign0 #() b(.in(c), .a(a), .b(b));
endmodule

.model logic logic

test #() t(a_, b_, c)
c_d_a #(.model("logic")) ca(a, a_);
c_d_a #(.model("logic")) cb(b, b_);


list

print op     v(a)       v(b)       v(c)
op

print tran v(a)       v(b)       v(c)       l(a_)       l(b_)       l(c)

tran .5u trace n
status notime
