verilog // simplified spice diode with limit

attach ./modelgen_0.so


// options nobypass
// options noincmode
options trtol=1
options gmin=.01p

`modelgen
module test_lt1(p, n);
electrical p, n;
parameter real is = .5e-14;

	analog function real mylimit;
		input vnew, vold, vt, vcrit;
		real vnew, vold, vt, vcrit, vlimit, arg;
		begin
			vlimit=vnew;
			if ((vnew > vcrit) && (abs(vnew-vold) > (vt+vt))) begin
				if (vold > 0) begin
					arg = 1 + (vnew-vold) / vt;
					if (arg >= 0)
						vlimit = vold + vt * ln(arg);
					else
						vlimit = vcrit;
				end else begin
					vlimit = vt * ln(vnew/vt);
				end
				$discontinuity(-1);
			end
			mylimit = vlimit;
		end
	endfunction

	analog begin : main
		real v;
		v = $limit(V(p, n), mylimit, $vt, 0.7);
		I(p,n) <+ is * (exp(v/$vt) - 1.);
	end
endmodule

!make test_lt1.so > /dev/null
attach ./test_lt1.so


resistor #(.r(1)) dut(\3 ,v);
test_lt1 #(.is(5e-15)) dut(\3 , \2 );
test_lt1 dut(\2 ,\1 );
test_lt1 dut(\1 ,\0 );
vsource v1(v, \0 );

list

print dc v(nodes) i(v1) iter(0)
dc v1 2.5 5.5 1 loop trace n
status notime
end
