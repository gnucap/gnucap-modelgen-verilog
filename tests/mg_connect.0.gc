attach ./modelgen_2.so
load vams/vpulse.so
load vams/vsine.so

verilog

`modelgen test_connect_0
module ad (out, in);
  input in;
  output out;
  reg out;

  electrical in;
  logic out;

  always @(cross(V(in) - 2.5, 1)) out = 1;
  always @(cross(V(in) - 2.5, -1)) out = 0;
endmodule
connectmodule aa(in, out);
  input in;
  output out;
  logic in;
  electrical out;
  always @(driver_update(in)) begin
    $strobe("driver_update %g", $abstime());
  end
endconnectmodule
`endmodelgen

list

!make test_connect_0.so > /dev/null
attach ./test_connect_0.so

ground gnd;
vsine #(.ampl(2.5), .offset(2.5), .freq(1e9)) v1(wave, gnd);
ad #() u1(ck, wave);
inv #(.model("logic"), .delay(150)) i1(ii, ck);
aa a1 (.out(d), .in(ii));

.model logic logic delay=1p rise=10p fall=10p

print tran v(wave) l(ck) iter(0) l(ii) v(ii) lastchange(ii) control(0) iter(0)
tran 3n
// 10p
// > AA.out

status notime
