attach ./modelgen_0.so
attach ../vams/vsine.so

verilog
ground gnd;
ground \0 ;

`modelgen
module test_lap_nd0b(p,n,cp, cn);
	electrical p, n;
	electrical cp, cn, x;
	analog begin
		V(p,x) <+ laplace_nd(.5*V(cp,cn), '{2.}, '{2.});
		V(x,n) <+ 1.5 * laplace_nd(-V(cn,cp), '{1.}, '{3.});
	end
endmodule

!make test_lap_nd0b.so > /dev/null
attach ./test_lap_nd0b.so

verilog
parameter r=1
parameter v=0

test_lap_nd0b #() dut(\3 , \0 , \1 ,\0 );
vsine #(.mag(1), .dc(v), .ampl(1)) v1(\1 , \0 );
resistor #(0.01) r1 (\3 , \0 );

list

print tran v(1) v(3) i(dut.*.out)
// print tran loss(dut.*)
tran 1 .1 trace=n
print ac v(1) vp(3) vm(3)
ac 2 4 * 2
status notime
end
