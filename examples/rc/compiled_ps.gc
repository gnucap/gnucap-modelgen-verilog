verilog
load mgsim

// the models we just compiled
load ./rc_ps.so

parameter real ic=1.

module main(\1 , \2 , \3 );
	ground gnd;
	rc_ps #(.ic(2)) myrc1(\1 , \2 , \3 );
	rc_ps #()       myrc2(\1 , \2 , \3 );
	resistor #(.r(1k)) r1(\2 , gnd);
endmodule

// instanciate it
ground gnd;
main m(\1 , \2 , gnd);

print tran v(nodes)
tran 1m
status notime
