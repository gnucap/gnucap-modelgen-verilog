load mgsim
verilog

load ./tline0.so

parameter z0=50.

ground gnd;

// built in tline for comparison
tline  #(.z0(z0) .delay(.2) tmatch1(m_out1 gnd m_in1 gnd );
tline0 #(.z0(z0) .delay(.2) tmatch2(m_out2 gnd m_in2 gnd );

resistor #(z0*.9) rmatch (m_out1 gnd);
resistor #(z0*.9) rmatch (m_out2 gnd);
resistor #(z0*.9) rin1 (m_in1 vsrc);
resistor #(z0*.9) rin1 (m_in2 vsrc);

spice
* TODO: use vams/vpulse
v1 vsrc gnd pulse rise=.1 fall=.1 iv=0 pv=1 delay=1 width=1 ac 1

.print tran v(vsrc) v(m_out*)
.tran 10 basic | {tee tline0.out}

.print ac vm(m_out*) vp(m_out*)
.ac .125 512 * 2
