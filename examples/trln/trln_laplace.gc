load mgsim
load ./trln0.so
verilog

parameter z0=50.
options trtol=5

ground gnd;

// TODO. need to fix tolerances..
options nobypass
options noincmode

trln0 #(.z0(z0)) tmatch(m_out gnd m_in gnd );
trln0 #(.z0(z0)) topen( nc gnd o_in gnd );
trln0 #(.z0(z0)) tshort(x x s_in gnd );


resistor #(z0) rmatch (m_out gnd);
resistor #(z0) rin1 (m_in vsrc);
resistor #(z0) rin2 (o_in vsrc);
resistor #(z0) rin3 (s_in vsrc);

spice
* TODO use vams/vpulse
v1 vsrc gnd pulse rise=.1 fall=.1 iv=0 pv=1 delay=1 width=2 ac 1

.print tran v(vsrc) v(m_in) v(s_in) v(o_in) v(m_out)
.tran 10 basic | {tee trln_laplace_tr.out}

.end

.print ac vm(*_in) vp(*_in)
.ac .125 512 * 2
